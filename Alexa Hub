            Text = T("no_comment"), TextColor3 = C.SubText,
            Font = Enum.Font.Gotham, TextSize = 11, ZIndex = 63,
        })
        return
    end
    for i, c in ipairs(comments) do
        local bubble = new("Frame", cmtList, {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = C.Black, BackgroundTransparency = 0.4,
            BorderSizePixel = 0, LayoutOrder = i, ClipsDescendants = true, ZIndex = 62,
        })
        corner(bubble, 4)
        new("UIPadding", bubble, {
            PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
            PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
        })
        new("TextLabel", bubble, {
