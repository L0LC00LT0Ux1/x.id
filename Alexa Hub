end

local function loadComments(postId)
    task.spawn(function()
        local data = httpRequest("GET", "/file/list")
        if not data or not data.files then return end
        local commentFiles = {}
        for _, f in ipairs(data.files) do
            local n = tostring(f.name or f.filename or "")
            if isCommentFile(n) then
                local meta = parseCommentFileName(n)
                if meta and tostring(meta.postId) == tostring(postId) then
                    table.insert(commentFiles, {id = f.id, meta = meta})
                end
            end
        end
        table.sort(commentFiles, function(a,b) return (a.meta.time or 0) < (b.meta.time or 0) end)
        local comments = {}
        for _, cf in ipairs(commentFiles) do
            local txt = httpRequest("GET", "/file/" .. tostring(cf.id))
            if type(txt) == "table" and txt.raw then txt = txt.raw end
            if type(txt) == "string" then
                table.insert(comments, {
                    user = cf.meta.userName,
                    text = txt,
                    time = cf.meta.time,
                })
            end
        end
        renderComments(comments)
    end)
end

