local lastChatNotifyTime = 0
task.spawn(function()
    while true do
        task.wait(CHAT_REFRESH_TIME)
        if Settings.chatNotify then
            local data = httpRequest("GET", "/file/list")
            if data and data.files then
                local chats = {}
                for _, f in ipairs(data.files) do
                    local n = tostring(f.name or f.filename or "")
                    if isChatFile(n) then
                        local meta = parseChatFileName(n)
                        if meta then table.insert(chats, {id = f.id, meta = meta}) end
                    end
                end
                if #chats > 0 then
                    table.sort(chats, function(a,b) return (a.meta.time or 0) < (b.meta.time or 0) end)
                    local latest = chats[#chats]
                    local latestTime = latest.meta.time or 0
                    if latestTime > lastChatNotifyTime and lastChatNotifyTime > 0 then
                        if latest.meta.user ~= LP.Name and not ChatPage.Visible then
                            local code = httpRequest("GET", "/file/" .. tostring(latest.id))
                            if type(code) == "table" and code.raw then code = code.raw end
                            if type(code) == "string" and #code > 0 then
                                ChatNotify(latest.meta.user or "?", code)
                            end
                        end
                    end
                    lastChatNotifyTime = latestTime
                end
            end
        end
    end
end)

