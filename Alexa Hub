local fpsBoostOn = false
local fpsOriginalMaterials, fpsOriginalFx = {}, {}
local function collectFPSData()
    fpsOriginalMaterials, fpsOriginalFx = {}, {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(Players) then
            fpsOriginalMaterials[obj] = {Material=obj.Material, Color=obj.Color, Reflectance=obj.Reflectance}
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
            or obj:IsA("Fire") or obj:IsA("Sparkles") then
            if obj.Enabled then fpsOriginalFx[obj] = true end
        end
    end
end
local function fpsBoostEnable()
    collectFPSData()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(Players) then
            pcall(function() obj.Material = Enum.Material.SmoothPlastic; obj.Reflectance = 0 end)
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
            or obj:IsA("Fire") or obj:IsA("Sparkles") then
            pcall(function() obj.Enabled = false end)
        end
    end
    pcall(function()
        Lighting.GlobalShadows = false; Lighting.FogEnd = 9e9
        Lighting.Brightness = 1.5; Lighting.OutdoorAmbient = Color3.fromRGB(140,140,140)
    end)
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
end
local function fpsBoostDisable()
    for obj, data in pairs(fpsOriginalMaterials) do
        if obj and obj.Parent and obj:IsA("BasePart") then
            pcall(function() obj.Material = data.Material; obj.Color = data.Color; obj.Reflectance = data.Reflectance end)
        end
    end
    for obj, _ in pairs(fpsOriginalFx) do
        if obj and obj.Parent then pcall(function() obj.Enabled = true end) end
    end
    pcall(function()
        Lighting.GlobalShadows = true; Lighting.FogEnd = 1000
        Lighting.Brightness = 2; Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
    end)
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level21 end)
    fpsOriginalMaterials, fpsOriginalFx = {}, {}
end
local function toggleFPSBoost(b)
    fpsBoostOn = not fpsBoostOn
    setButtonState(b, fpsBoostOn)
    if fpsBoostOn then fpsBoostEnable(); Notify("เปิด FPS Boost ⚡")
    else fpsBoostDisable(); Notify("ปิด FPS Boost ✘") end
end

