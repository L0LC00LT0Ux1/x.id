local function makeButton(parent, text, size, layoutOrder, onClick)
    local b = new("TextButton", parent, {
        Name="btn_"..text, Size=size or UDim2.fromOffset(60,50),
        BackgroundColor3=C.Dark2, BorderSizePixel=0, Text=text,
        TextColor3=C.Text, TextSize=15, Font=Enum.Font.SciFi,
        TextWrapped=true, AutoButtonColor=false, LayoutOrder=layoutOrder or 0,
        TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=5,
    })
    corner(b, 8)
    local st = stroke(b, C.RedDark, 1)
    buttonData[b] = { stroke=st, on=false }
    b.MouseEnter:Connect(function()
        SoundLib.play("Hover")
        local on = buttonData[b] and buttonData[b].on
        tween(b, 0.15, {BackgroundColor3 = on and C.RedBright or C.RedDeep}); tween(st, 0.15, {Thickness=2})
    end)
    b.MouseLeave:Connect(function()
        local on = buttonData[b] and buttonData[b].on
        tween(b, 0.15, {BackgroundColor3 = on and C.Red or C.Dark2})
        tween(st, 0.15, {Color = on and C.RedBright or C.RedDark, Thickness=1})
    end)
    b.MouseButton1Click:Connect(function()
        SoundLib.play("Click")
        if onClick then onClick(b) end
    end)
    return b
end

