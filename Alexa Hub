-- ════════ 🔢 Count Comments ════════
local function countCommentsForPost(postId)
    local count = 0
    for _, f in ipairs(allFiles) do
        local n = tostring(f.name or f.filename or "")
        if isCommentFile(n) then
            local meta = parseCommentFileName(n)
            if meta and meta.postId == postId then count = count + 1 end
        end
    end
    return count
end

-- ════════ Render ════════
local function renderList()
    clearList()
    local query = string.lower(searchBox.Text or "")
    local filtered = {}
    for _, f in ipairs(allFiles) do
        local meta = parseFileName(f.name or f.filename or "")
        local haystack = string.lower((meta.name or "") .. " " .. (meta.author or "") .. " " .. (meta.desc or ""))
        if query == "" or string.find(haystack, query, 1, true) then
            table.insert(filtered, {file = f, meta = meta})
        end
    end
    -- Sort
    if sortMode == "latest" then
        table.sort(filtered, function(a,b) return (a.meta.time or 0) > (b.meta.time or 0) end)
    elseif sortMode == "oldest" then
        table.sort(filtered, function(a,b) return (a.meta.time or 0) < (b.meta.time or 0) end)
    elseif sortMode == "mostLiked" then
        table.sort(filtered, function(a,b)
            local la = likesMap[tostring(a.file.id)] and likesMap[tostring(a.file.id)].count or 0
            local lb = likesMap[tostring(b.file.id)] and likesMap[tostring(b.file.id)].count or 0
            return la > lb
        end)
    elseif sortMode == "leastLiked" then
        table.sort(filtered, function(a,b)
            local la = likesMap[tostring(a.file.id)] and likesMap[tostring(a.file.id)].count or 0
            local lb = likesMap[tostring(b.file.id)] and likesMap[tostring(b.file.id)].count or 0
            return la < lb
        end)
    end

    local count = 0
    for _, item in ipairs(filtered) do
        count = count + 1
        item.file._commentCount = countCommentsForPost(tostring(item.file.id))
        createCard(item.file, count)
    end
    if count == 0 then
        new("TextLabel", listFrame, {
            Size = UDim2.new(1, -8, 0, 40), BackgroundTransparency = 1,
            Text = (#allFiles == 0) and T("no_script") or T("no_match"),
            TextColor3 = C.SubText, Font = Enum.Font.GothamBold,
            TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 8,
        })
    end
end

