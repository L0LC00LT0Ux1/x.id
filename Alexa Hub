    if loadingScripts then return end
    loadingScripts = true
    clearList()
    new("TextLabel", listFrame, {
        Size = UDim2.new(1, -8, 0, 40), BackgroundTransparency = 1,
        Text = T("loading"), TextColor3 = C.RedBright,
        Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 8,
    })
    task.spawn(function()
        local data, err = httpRequest("GET", "/file/list")
        loadingScripts = false
        if not data or not data.files then
            clearList()
            new("TextLabel", listFrame, {
                Size = UDim2.new(1, -8, 0, 40), BackgroundTransparency = 1,
                Text = "❌ " .. tostring(err), TextColor3 = C.Red,
                Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 8,
            })
            return
        end
        -- Reset maps
        likesMap = {}
        likeFileMap = {}
        local scripts = {}
        for _, f in ipairs(data.files) do
            local n = tostring(f.name or f.filename or "")
            if isChatFile(n) then
                -- skip chat
            elseif isLikeFile(n) then
                local lm = parseLikeFileName(n)
                if lm then
                    likesMap[lm.postId] = likesMap[lm.postId] or { count = 0, users = {} }
                    likesMap[lm.postId].count = likesMap[lm.postId].count + 1
                    likesMap[lm.postId].users[lm.userId] = true
                    likeFileMap[lm.postId] = likeFileMap[lm.postId] or {}
                    likeFileMap[lm.postId][lm.userId] = f.id
                end
            elseif isCommentFile(n) then
                -- skip comment (counted later)
            else
                table.insert(scripts, f)
            end
        end
        allFiles = scripts
        renderList()
    end)
end

