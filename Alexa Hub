local function renderComments(comments)
    for _, c in ipairs(cmtList:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
    end
    if #comments == 0 then
        new("TextLabel", cmtList, {
