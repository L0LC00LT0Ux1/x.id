        TextColor3=C.Text, Font=Enum.Font.Gotham, TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Top,
        TextWrapped=true, ZIndex=8,
    })
end
local function renderChat()
    clearChat()
    if #chatMessages == 0 then
        new("TextLabel", chatList, {
            Size=UDim2.new(1, -8, 0, 40), BackgroundTransparency=1,
            Text=T("empty_chat"), TextColor3=C.SubText,
            Font=Enum.Font.GothamBold, TextSize=11, ZIndex=8,
        })
        return
    end
    for i, m in ipairs(chatMessages) do m.order = i; createChatBubble(m) end
end
local loadingChat = false
local function loadChat(silent)
    if loadingChat then return end
    loadingChat = true
    if not silent then
        clearChat()
        new("TextLabel", chatList, {
            Size=UDim2.new(1, -8, 0, 40), BackgroundTransparency=1,
            Text=T("loading"), TextColor3=C.RedBright,
            Font=Enum.Font.GothamBold, TextSize=12, ZIndex=8,
        })
    end
    task.spawn(function()
        local data, err = httpRequest("GET", "/file/list")
        loadingChat = false
        if not data or not data.files then
            if not silent then
                clearChat()
                new("TextLabel", chatList, {
                    Size=UDim2.new(1, -8, 0, 40), BackgroundTransparency=1,
                    Text="❌ " .. tostring(err), TextColor3=C.Red,
                    Font=Enum.Font.GothamBold, TextSize=11, ZIndex=8,
                })
            end
            return
        end
        local chats = {}
        for _, f in ipairs(data.files) do
            local n = tostring(f.name or f.filename or "")
            if isChatFile(n) then
                local meta = parseChatFileName(n)
                if meta then table.insert(chats, {id = f.id, meta = meta}) end
            end
        end
        table.sort(chats, function(a,b) return (a.meta.time or 0) < (b.meta.time or 0) end)
        local start = math.max(1, #chats - 99)
        local newMessages = {}
        for i = start, #chats do
            local c = chats[i]
            local code = httpRequest("GET", "/file/" .. tostring(c.id))
            if type(code) == "table" and code.raw then code = code.raw end
            if type(code) == "string" then
                table.insert(newMessages, {
                    user = c.meta.user or "?", text = code,
                    timeStr = os.date("%H:%M", c.meta.time), order = i,
                })
            end
        end
        chatMessages = newMessages
        renderChat()
        task.wait(0.05)
        pcall(function() chatList.CanvasPosition = Vector2.new(0, chatList.AbsoluteCanvasSize.Y) end)
    end)
end
local sendingChat = false
local function sendChat()
    if sendingChat then return end
    local text = chatInput.Text
    if not text or text == "" then return Notify(T("type_msg")) end
    if #text > 500 then return Notify("Max 500 chars") end
    sendingChat = true
    SoundLib.play("Chat")
    local fileName = buildChatFileName(LP.Name, os.time())
    task.spawn(function()
        local res, err = httpRequest("POST", "/file", text, {
            ["Content-Type"] = "text/plain",
            ["X-File-Name"] = fileName,
        })
        sendingChat = false
        if res or not err then
            chatInput.Text = ""
            task.wait(0.3); loadChat(true)
        else
            Notify("❌ " .. tostring(err))
        end
    end)
end
chatSendBtn.MouseButton1Click:Connect(sendChat)
chatInput.FocusLost:Connect(function(enter) if enter then sendChat() end end)
chatRefreshBtn.MouseButton1Click:Connect(function() SoundLib.play("Click"); loadChat(false) end)

