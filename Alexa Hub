end
local function createChatBubble(msg)
    local bubble = new("Frame", chatList, {
        Size=UDim2.new(1, -8, 0, 0), AutomaticSize=Enum.AutomaticSize.Y,
        BackgroundColor3=C.RedDeep, BackgroundTransparency=0.35,
