local espOn = false
local espFolder = new("Folder", espLayer, {Name="ESP"})
local function createESP(plr)
    if plr == LP then return end
    local char = plr.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local tag = new("BillboardGui", espFolder, {
        Name=plr.Name.."_tag", Adornee=hrp,
        Size=UDim2.fromOffset(180,46),
        StudsOffset=Vector3.new(0,3.2,0), AlwaysOnTop=true,
    })
    new("TextLabel", tag, {
        Size=UDim2.new(1,0,0.5,0), BackgroundTransparency=1,
        Text=plr.Name, TextColor3=C.Text, TextStrokeTransparency=0,
        TextStrokeColor3=C.Black, Font=Enum.Font.GothamBold, TextSize=13,
    })
    local infoLbl = new("TextLabel", tag, {
        Position=UDim2.new(0,0,0.5,0), Size=UDim2.new(1,0,0.5,0),
        BackgroundTransparency=1, Text="", TextColor3=C.RedBright,
        TextStrokeTransparency=0, TextStrokeColor3=C.Black,
        Font=Enum.Font.GothamBold, TextSize=11,
    })
    local box = new("Frame", espFolder, {
        Name=plr.Name.."_box", BackgroundTransparency=1,
        BorderSizePixel=0, Visible=false, ZIndex=15,
    })
    stroke(box, C.Red, 1.5)
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not (espOn and tag.Parent and hrp.Parent and box.Parent) then
            if conn then conn:Disconnect() end; return
        end
        if hum.Health <= 0 or not char.Parent then
            tag:Destroy(); box:Destroy()
            if conn then conn:Disconnect() end; return
        end
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local dist = myRoot and math.floor((myRoot.Position - hrp.Position).Magnitude) or 0
        infoLbl.Text = string.format("HP: %d | %dm", math.floor(hum.Health), dist)
        local topPos, topOn = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0, 3, 0)).Position)
        local botPos, botOn = Camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(0,-3, 0)).Position)
        if topOn and botOn and topPos.Z > 0 and botPos.Z > 0 then
            local h = math.abs(botPos.Y - topPos.Y); local w = h * 0.55
            box.Position = UDim2.fromOffset(topPos.X - w/2, topPos.Y)
            box.Size = UDim2.fromOffset(w, h); box.Visible = true
        else box.Visible = false end
    end)
end
local espConns = {}
local function enableESP()
    espOn = true
    for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then createESP(p) end end
    table.insert(espConns, Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function() task.wait(0.5); if espOn then createESP(p) end end)
    end))
    table.insert(espConns, Players.PlayerRemoving:Connect(function(p)
        for _, suffix in ipairs({"_tag","_box"}) do
            local t = espFolder:FindFirstChild(p.Name..suffix); if t then t:Destroy() end
        end
    end))
end
local function disableESP()
    espOn = false
    for _, c in ipairs(espConns) do c:Disconnect() end
    espConns = {}
    for _, v in ipairs(espFolder:GetChildren()) do v:Destroy() end
end
local function toggleESP(b)
    if espOn then disableESP(); setButtonState(b, false); Notify("ปิด ESP ✘")
    else enableESP(); setButtonState(b, true); Notify("เปิด ESP 👁️") end
end

