function applyLanguage()
    settingsTitle.Text = T("settings_title")
    langLabel.Text = T("lang_label")
    sizeLabel.Text = T("size_label")
    notiLabel.Text = T("noti_label")
    updateLabel.Text = T("update_label")
    discordBtn.Text = T("update_discord")
    searchBox.PlaceholderText = T("search_placeholder")
    refreshBtn.Text = T("refresh")
    shareBtn.Text = T("share")
    chatInput.PlaceholderText = T("type_msg")
    chatSendBtn.Text = T("send")
    chatRefreshBtn.Text = T("refresh")
    -- Sort buttons
    for i, item in ipairs(SORT_KEYS) do
        local btn = sortButtons[item.key]
        if btn then btn.Text = T(item.label) end
    end
    -- Size buttons
    for k, btn in pairs(sizeButtons) do
        btn.Text = T("size_" .. k)
    end
    -- Notify buttons
    if notiButtons.chatNotify then notiButtons.chatNotify.Text = T("noti_chat") end
    if notiButtons.menuNotify then notiButtons.menuNotify.Text = T("noti_menu") end
    -- Tab buttons
    if tabMainBtn then tabMainBtn.Text = T("tab_main") end
    if tabScriptBtn then tabScriptBtn.Text = T("tab_script") end
    if tabChatBtn then tabChatBtn.Text = T("tab_chat") end
    if tabSettingsBtn then tabSettingsBtn.Text = T("tab_settings") end
    -- Re-render script list if visible
    if ScriptPage.Visible then renderList() end
end

