local B64_STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64Encode(s)
    local out={}; local n=#s; local i=1
    while i<=n do
        local a=s:byte(i) or 0; local b=s:byte(i+1) or 0; local c=s:byte(i+2) or 0
        local comb=a*65536+b*256+c
        out[#out+1]=B64_STD:sub(math.floor(comb/262144)%64+1, math.floor(comb/262144)%64+1)
        out[#out+1]=B64_STD:sub(math.floor(comb/4096)%64+1, math.floor(comb/4096)%64+1)
        out[#out+1]=(i+1<=n) and B64_STD:sub(math.floor(comb/64)%64+1, math.floor(comb/64)%64+1) or "="
        out[#out+1]=(i+2<=n) and B64_STD:sub(comb%64+1, comb%64+1) or "="
        i=i+3
    end
    return table.concat(out)
end
local function b64Decode(s)
    s=s:gsub("[^A-Za-z0-9+/=]","")
    local out={}; local n=#s; local i=1
    while i<=n do
        local c1=(B64_STD:find(s:sub(i,i),1,true) or 1)-1
        local c2=(B64_STD:find(s:sub(i+1,i+1),1,true) or 1)-1
        local c3=(i+2<=n) and ((B64_STD:find(s:sub(i+2,i+2),1,true) or 1)-1) or 0
        local c4=(i+3<=n) and ((B64_STD:find(s:sub(i+3,i+3),1,true) or 1)-1) or 0
        local comb=c1*262144+c2*4096+c3*64+c4
        out[#out+1]=string.char(math.floor(comb/65536)%256)
        if s:sub(i+2,i+2)~="=" and i+2<=n then out[#out+1]=string.char(math.floor(comb/256)%256) end
        if s:sub(i+3,i+3)~="=" and i+3<=n then out[#out+1]=string.char(comb%256) end
        i=i+4
    end
    return table.concat(out)
end
local function b64UrlEncode(s) return (b64Encode(s):gsub("+","-"):gsub("/","_"):gsub("=+$","")) end
local function b64UrlDecode(s)
    s=s:gsub("-","+"):gsub("_","/")
    local pad=#s%4
    if pad==2 then s=s.."==" elseif pad==3 then s=s.."=" end
    return b64Decode(s)
end
local function urlDecodeUTF8(s)
    if not s then return "" end
    s = tostring(s):gsub("%+", " ")
    return s:gsub("%%(%x%x)", function(hex) return string.char(tonumber(hex, 16)) end)
end

-- ════════ 📎 Metadata ════════
local function buildFileName(name, author, userId, desc, ts)
    local meta = HttpService:JSONEncode({
        n=tostring(name or ""), a=tostring(author or ""),
        u=tonumber(userId) or 0, d=tostring(desc or ""),
        t=tonumber(ts) or os.time(),
    })
    return b64UrlEncode(meta) .. ".lua"
end
local function parseFileName(raw)
    if not raw then return { name="?", author="?", authorId=0, desc="", time=0 } end
    local cleaned = tostring(raw):gsub("%.lua$", "")
    local candidates = { cleaned, urlDecodeUTF8(cleaned), urlDecodeUTF8(urlDecodeUTF8(cleaned)) }
    local okB64, b64 = pcall(b64UrlDecode, cleaned)
    if okB64 and b64 and #b64 > 0 then
        table.insert(candidates, b64)
        table.insert(candidates, urlDecodeUTF8(b64))
    end
    for _, c in ipairs(candidates) do
        local ok, meta = pcall(function() return HttpService:JSONDecode(c) end)
        if ok and type(meta) == "table" and (meta.n or meta.a) then
            return {
                name=tostring(meta.n or "?"), author=tostring(meta.a or "?"),
                authorId=tonumber(meta.u) or 0, desc=tostring(meta.d or ""),
                time=tonumber(meta.t) or 0,
            }
        end
    end
    return { name=cleaned, author="?", authorId=0, desc="", time=0 }
end

-- ════════ 💬 Chat Metadata ════════
local function buildChatFileName(user, time)
    return "__chat__|" .. b64UrlEncode(tostring(user or "")) .. "|" .. tostring(time or 0) .. ".lua"
end
local function parseChatFileName(raw)
    if not raw then return nil end
    local base = tostring(raw):gsub("%.lua$", "")
    local candidates = { base, urlDecodeUTF8(base) }
    local okB64, b64 = pcall(b64UrlDecode, base)
    if okB64 and b64 then table.insert(candidates, b64) end
    for _, s in ipairs(candidates) do
        local u, t = s:match("^__chat__|([^|]*)|(%d+)$")
        if u and t then
            local okU, user = pcall(b64UrlDecode, u)
            return { user = (okU and user) or "?", time = tonumber(t) or 0 }
        end
        local t2 = s:match("^__chat__|(%d+)$")
        if t2 then return { user = "?", time = tonumber(t2) or 0 } end
    end
    return nil
end

-- ════════ ❤️ Like Metadata ════════
-- Format: __like__|<b64(postId)>|<b64(userId)>|<b64(userName)>.lua  (empty body)
local function buildLikeFileName(postId, userId, userName)
    return "__like__|" .. b64UrlEncode(tostring(postId or "")) .. "|" .. b64UrlEncode(tostring(userId or 0)) .. "|" .. b64UrlEncode(tostring(userName or "")) .. ".lua"
end
local function parseLikeFileName(raw)
    if not raw then return nil end
    local base = tostring(raw):gsub("%.lua$", "")
    local candidates = { base, urlDecodeUTF8(base) }
    local okB64, b64 = pcall(b64UrlDecode, base)
    if okB64 and b64 then table.insert(candidates, b64) end
    for _, s in ipairs(candidates) do
        local p, u, n = s:match("^__like__|([^|]*)|([^|]*)|([^|]*)$")
        if p then
            local okP, pid = pcall(b64UrlDecode, p)
            local okU, uid = pcall(b64UrlDecode, u)
            local okN, uname = pcall(b64UrlDecode, n)
            return {
                postId = (okP and pid) or p,
                userId = tonumber((okU and uid) or u) or 0,
                userName = (okN and uname) or "?",
            }
        end
    end
    return nil
end

-- ════════ 💬 Comment Metadata ════════
-- Format: __comment__|<b64(postId)>|<b64(userName)>|<time>.lua  (body = comment text)
local function buildCommentFileName(postId, userName, time)
    return "__comment__|" .. b64UrlEncode(tostring(postId or "")) .. "|" .. b64UrlEncode(tostring(userName or "")) .. "|" .. tostring(time or 0) .. ".lua"
end
local function parseCommentFileName(raw)
    if not raw then return nil end
    local base = tostring(raw):gsub("%.lua$", "")
    local candidates = { base, urlDecodeUTF8(base) }
    local okB64, b64 = pcall(b64UrlDecode, base)
    if okB64 and b64 then table.insert(candidates, b64) end
    for _, s in ipairs(candidates) do
        local p, n, t = s:match("^__comment__|([^|]*)|([^|]*)|(%d+)$")
        if p then
            local okP, pid = pcall(b64UrlDecode, p)
            local okN, uname = pcall(b64UrlDecode, n)
            return {
                postId = (okP and pid) or p,
                userName = (okN and uname) or "?",
                time = tonumber(t) or 0,
            }
        end
    end
    return nil
end

-- ════════ 🏷️ File Type Detectors ════════
local function matchesPrefix(raw, prefix)
    if not raw then return false end
    local base = tostring(raw):gsub("%.lua$", "")
    local candidates = { tostring(raw), urlDecodeUTF8(tostring(raw)), base, urlDecodeUTF8(base) }
    local okB64, b64 = pcall(b64UrlDecode, base)
    if okB64 and b64 then table.insert(candidates, b64) end
    for _, s in ipairs(candidates) do
        if s:find(prefix, 1, true) then return true end
    end
    return false
end
local function isChatFile(raw) return matchesPrefix(raw, "__chat__") end
local function isLikeFile(raw) return matchesPrefix(raw, "__like__") end
local function isCommentFile(raw) return matchesPrefix(raw, "__comment__") end

-- ════════ HTTP 🌐 ════════
local function httpRequest(method, path, body, extraHeaders)
    local url = SCRIPT_SERVER .. path
    local headers = { ["X-Site-Token"] = SITE_TOKEN }
    if extraHeaders then for k, v in pairs(extraHeaders) do headers[k] = v end end
    if body and not headers["Content-Type"] then headers["Content-Type"] = "application/json" end
    local opts = { Url = url, Method = method, Headers = headers }
    if body then opts.Body = body end
    local ok, res = pcall(function() return HttpService:RequestAsync(opts) end)
    if not ok then return nil, tostring(res) end
    if not res.Success then return nil, "HTTP " .. tostring(res.StatusCode) end
    local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok2 then return res.Body, nil end
    return data, nil
end

