        if xrayOn and obj:IsA("BasePart") then applyXRayTo(obj) end
    end)
end
local function disableXRay()
    xrayOn = false
    if xrayConn then xrayConn:Disconnect(); xrayConn = nil end
    for part, orig in pairs(xrayBackup) do
        if part and part.Parent then pcall(function() part.LocalTransparencyModifier = orig end) end
    end
    xrayBackup = {}
end
