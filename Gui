        Parent = loading,
    })

    local statusLbl = create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 14),
        Position = UDim2.new(0, 10, 0, 160),
        BackgroundTransparency = 1,
        Text = SUBTITLE,
        TextColor3 = Color3.fromRGB(180, 180, 180),
        Font = FONT_MED,
        TextSize = 10,
        ZIndex = 3002,
        Parent = loading,
    })

    local barBg = create("Frame", {
        Size = UDim2.new(0, 180, 0, 4),
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 186),
        BackgroundColor3 = Color3.fromRGB(60, 60, 65),
        BorderSizePixel = 0,
        ZIndex = 3002,
        Parent = loading,
    }, { corner(2) })

    local barFill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 3003,
        Parent = barBg,
    }, { corner(2) })

    local pctLbl = create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 12),
        Position = UDim2.new(0, 10, 0, 196),
        BackgroundTransparency = 1,
        Text = "0%",
        TextColor3 = Color3.fromRGB(180, 180, 180),
        Font = FONT_MED,
        TextSize = 9,
        ZIndex = 3002,
        Parent = loading,
    })

    local function typeText(lbl, text, total)
        local chars = {}
        for _, code in utf8.codes(text) do table.insert(chars, utf8.char(code)) end
        local step = total / math.max(#chars, 1)
        lbl.Text = ""
        for i = 1, #chars do
            lbl.Text = table.concat(chars, "", 1, i)
            task.wait(step)
        end
    end

    local function fadeAll(root, t)
        local info = TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local list = { root }
        for _, d in ipairs(root:GetDescendants()) do table.insert(list, d) end
        for _, o in ipairs(list) do
            local p = {}
            if o:IsA("UIStroke") then p.Transparency = 1
            elseif o:IsA("GuiObject") then
                p.BackgroundTransparency = 1
                if o:IsA("ImageLabel") or o:IsA("ImageButton") then p.ImageTransparency = 1 end
                if o:IsA("TextLabel") or o:IsA("TextButton") then p.TextTransparency = 1 end
            end
            if next(p) then TweenService:Create(o, info, p):Play() end
        end
    end

    task.spawn(function()
        TweenService:Create(icon, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            ImageTransparency = 0,
            ImageColor3 = Color3.new(1, 1, 1),
        }):Play()

        task.spawn(function()
            task.wait(0.2)
            typeText(titleLbl, TITLE, 1.2)
        end)

        task.wait(1.2)
        TweenService:Create(barFill, TweenInfo.new(3, Enum.EasingStyle.Linear), {
            Size = UDim2.new(1, 0, 1, 0),
        }):Play()

        local t0 = os.clock()
        while os.clock() - t0 < 3 do
            local p = math.floor((os.clock() - t0) / 3 * 100)
            pctLbl.Text = p .. "%"
            task.wait(0.03)
        end
        pctLbl.Text = "100%"
        statusLbl.Text = "เสร็จสมบูรณ์ ✅"
        task.wait(0.5)

        fadeAll(loading, 0.6)
        task.wait(0.65)
        if loading.Parent then loading:Destroy() end
        if onDone then task.spawn(onDone) end
    end)
end

-- ============================================================
-- State Management (per window)
-- ============================================================
local function makeState()
    return {
        theme = "dark",
        sizeKey = "กลาง",
        offsetX = nil,
        offsetY = nil,
        configs = {},
    }
end

local function loadState(path, default)
    if not path then return default end
    local raw = safeRead(path)
    if not raw or #raw == 0 then return default end
    local dec = jsonDecode(raw)
    if type(dec) ~= "table" then return default end
    for k, v in pairs(default) do
        if dec[k] == nil then dec[k] = v end
    end
    if type(dec.configs) ~= "table" then dec.configs = {} end
    return dec
end

-- ============================================================
-- Window Class
-- ============================================================
local Window = {}
Window.__index = Window

local SIZES = {
    ["เล็ก"] = { W = 320, H = 250 },
    ["กลาง"] = { W = 380, H = 300 },
    ["ใหญ่"] = { W = 440, H = 350 },
}

local REOPEN_ICON = "rbxassetid://131189375436308"

function SkadLib:CreateWindow(cfg)
    cfg = cfg or {}
    local win = setmetatable({}, Window)

    -- State path
    local saveCfg = cfg.ConfigurationSaving or {}
    local folder = saveCfg.FolderName or "SkadLib"
    local file = saveCfg.FileName or (slug(cfg.Name or "Window") .. ".json")
    local statePath = saveCfg.Enabled == false and nil or (folder .. "/" .. file)
    win.StatePath = statePath

    local defaultState = makeState()
    win.State = statePath and loadState(statePath, defaultState) or defaultState

    if type(win.State.configs) ~= "table" then win.State.configs = {} end

    -- Size
    local sizeKey = win.State.sizeKey
    if not SIZES[sizeKey] then sizeKey = "กลาง" end
    win.SizeKey = sizeKey
    win.WIN_W = SIZES[sizeKey].W
    win.WIN_H = SIZES[sizeKey].H

    if win.State.offsetX == nil then win.State.offsetX = -win.WIN_W / 2 end
    if win.State.offsetY == nil then win.State.offsetY = -win.WIN_H / 2 end

    -- Theme
    win.ThemeRefs = {}
    win.ThemeRefresh = {}
    win.Theme = {}
    local pal = PALETTES[win.State.theme] or PALETTES.dark
    for k, v in pairs(pal) do win.Theme[k] = v end
    SkadLib.ActiveTheme = win.Theme

    -- Store global config
    win.Config = cfg
    win.Tabs = {}
    win.TabButtons = {}
    win.TabParts = {}
    win.TabPages = {}
    win.Loaded = false
    win.IsOpen = true
    win.IsMinimized = false

    local function reg(obj, prop, role)
        table.insert(win.ThemeRefs, { obj = obj, prop = prop, role = role })
    end
    local function regRefresh(fn) table.insert(win.ThemeRefresh, fn) end
    win._reg = reg
    win._regRefresh = regRefresh

    local function saveState()
        if not win.StatePath then return end
        local enc = jsonEncode(win.State)
        if enc then safeWrite(win.StatePath, enc) end
    end
    win._save = saveState

    -- Apply theme
    local function applyTheme(mode, doSave)
        win.State.theme = mode
        local pal2 = PALETTES[mode] or PALETTES.dark
        for k, v in pairs(pal2) do win.Theme[k] = v end
        SkadLib.ActiveTheme = win.Theme
        for _, r in ipairs(win.ThemeRefs) do
            if r.obj and r.obj.Parent then r.obj[r.prop] = win.Theme[r.role] end
        end
        for _, fn in ipairs(win.ThemeRefresh) do pcall(fn) end
        if doSave ~= false then saveState() end
    end
    win._applyTheme = applyTheme

    -- ============================================================
    -- GUI Structure
    -- ============================================================
    local parent = getGuiParent()
    local old = parent:FindFirstChild("SkadLib_Window")
    if old then old:Destroy() end

    local screenGui = create("ScreenGui", {
        Name = "SkadLib_Window",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = parent,
    })
    win.ScreenGui = screenGui

    local TITLE_H, SIDE_W = 32, 130

    local main = create("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(win.WIN_W, win.WIN_H),
        Position = UDim2.new(0.5, win.State.offsetX, 0.5, win.State.offsetY),
        BackgroundColor3 = win.Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false,
        Active = true,
        Parent = screenGui,
    }, { corner(14), mkStroke(win.Theme.Border) })
    reg(main, "BackgroundColor3", "Background")
    reg(main:FindFirstChildOfClass("UIStroke"), "Color", "Border")

    local bgImg = create("ImageLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Image = cfg.BackgroundImage or "rbxassetid://79384935570301",
        ScaleType = Enum.ScaleType.Crop,
        ImageTransparency = 0.15,
        ZIndex = 0,
        Parent = main,
    }, { corner(14) })

    local shade = create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = win.Theme.Shade,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        ZIndex = 0,
        Parent = main,
    }, { corner(14) })
    reg(shade, "BackgroundColor3", "Shade")

    -- Title Bar
    local titleBar = create("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, TITLE_H),
        BackgroundTransparency = 1,
        Active = true,
        ZIndex = 2,
        Parent = main,
    })

    local titleLbl = create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = cfg.Name or "Hub",
