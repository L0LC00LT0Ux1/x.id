    -- ============================================================
    local function makeDraggable(handle, target, onClick, savePos)
        handle.Active = true
        local dInput, dStart, sPos, moved = nil, nil, nil, 0
        local endConn, mouseConn

        local function cleanup()
            if endConn then endConn:Disconnect(); endConn = nil end
            if mouseConn then mouseConn:Disconnect(); mouseConn = nil end
            dInput = nil
        end

        local function onEnd()
            if onClick and moved < 6 then onClick() end
            if savePos and moved >= 6 then
                win.State.offsetX = target.Position.X.Offset
                win.State.offsetY = target.Position.Y.Offset
                saveState()
            end
            cleanup()
        end

        handle.InputBegan:Connect(function(input)
            if dInput then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dInput = input
                dStart = input.Position
                sPos = target.Position
                moved = 0
                endConn = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then onEnd() end
                end)
                mouseConn = UserInputService.InputChanged:Connect(function(m)
                    if m.UserInputType == Enum.UserInputType.MouseMovement then
                        local delta = m.Position - dStart
                        moved = math.max(moved, delta.Magnitude)
                        target.Position = UDim2.new(
                            sPos.X.Scale, sPos.X.Offset + delta.X,
                            sPos.Y.Scale, sPos.Y.Offset + delta.Y
                        )
                    end
                end)
            elseif input.UserInputType == Enum.UserInputType.Touch then
                dInput = input
                dStart = input.Position
                sPos = target.Position
                moved = 0
                endConn = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        onEnd()
                    elseif input.UserInputState == Enum.UserInputState.Change then
                        local delta = input.Position - dStart
                        moved = math.max(moved, delta.Magnitude)
                        target.Position = UDim2.new(
                            sPos.X.Scale, sPos.X.Offset + delta.X,
                            sPos.Y.Scale, sPos.Y.Offset + delta.Y
                        )
                    end
                end)
            end
        end)
    end

