function Tab:AddSlider(cfg)
    cfg = cfg or {}
    local min, max = cfg.Min or 0, cfg.Max or 100
    local value = cfg.Default or min
    if cfg.ConfigKey and self.Win.State.configs[cfg.ConfigKey] ~= nil then
        value = self.Win.State.configs[cfg.ConfigKey]
    end
    local frame = makeRow(self, cfg.Name, self._nextOrderFn(), 46)
    local T = self.Win.Theme

    local valLbl = create("TextLabel", {
        Size = UDim2.fromOffset(50, 18),
        Position = UDim2.new(1, -60, 0, 6),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = T.Text,
        Font = FONT,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame,
    })
    self._reg(valLbl, "TextColor3", "Text")

    local bar = create("Frame", {
        Size = UDim2.new(1, -20, 0, 6),
        Position = UDim2.new(0, 10, 1, -14),
        BackgroundColor3 = T.Off,
        BorderSizePixel = 0,
        Active = true,
        Parent = frame,
    }, { corner(3) })
    self._reg(bar, "BackgroundColor3", "Off")

    local fill = create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = T.Text,
        BorderSizePixel = 0,
        Parent = bar,
    }, { corner(3) })
    self._reg(fill, "BackgroundColor3", "Text")

    local dragInput, endConn = nil, nil

    local function update(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        valLbl.Text = tostring(value)
        if cfg.ConfigKey then self.Win.State.configs[cfg.ConfigKey] = value end
        if cfg.Callback then task.spawn(cfg.Callback, value) end
    end

    local function finish()
        if endConn then endConn:Disconnect(); endConn = nil end
        dragInput = nil
        if cfg.ConfigKey then self.Win._save() end
    end

    bar.InputBegan:Connect(function(input)
        if dragInput then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
            update(input.Position.X)
            endConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    finish()
                elseif input.UserInputState == Enum.UserInputState.Change then
                    update(input.Position.X)
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragInput then return end
        if dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragInput then return end
        if input == dragInput then
            finish()
        elseif dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1 then
            finish()
        end
    end)

    local handle = { Value = value, Set = function(_, v)
        value = math.clamp(v, min, max)
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        valLbl.Text = tostring(value)
        if cfg.ConfigKey then
            self.Win.State.configs[cfg.ConfigKey] = value
            self.Win._save()
        end
        if cfg.Callback then task.spawn(cfg.Callback, value) end
    end }
    if cfg.Callback then task.spawn(cfg.Callback, value) end
    return handle
end

