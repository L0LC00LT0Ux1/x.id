local notifyHolder, notifyEnabled = nil, true
local NOTIFY_ICON = "rbxassetid://97852242846706"

local function ensureNotifHolder()
    if notifyHolder and notifyHolder.Parent then return notifyHolder end
    local parent = getGuiParent()
    notifyHolder = create("Frame", {
        Name = "SkadLib_Notifications",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 10),
        Size = UDim2.fromOffset(230, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ZIndex = 1000,
        Parent = parent,
    }, {
        create("UIListLayout", {
            Padding = UDim.new(0, 6),
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })
    return notifyHolder
end

function SkadLib:SetNotifications(enabled)
    notifyEnabled = enabled and true or false
end

function SkadLib:Notify(cfg)
    cfg = cfg or {}
    if not notifyEnabled then return end
    local T = SkadLib.ActiveTheme or PALETTES.dark
    local holder = ensureNotifHolder()

    local card = create("Frame", {
        Size = UDim2.fromOffset(230, 46),
        BackgroundColor3 = T.Background,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 1000,
        Parent = holder,
    }, { corner(8), mkStroke(T.Border) })

    local icon = create("ImageLabel", {
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.fromOffset(10, 10),
        BackgroundTransparency = 1,
        Image = cfg.Icon or NOTIFY_ICON,
        ImageTransparency = 1,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 1001,
        Parent = card,
    })

    local tLbl = create("TextLabel", {
        Size = UDim2.new(1, -50, 0, 16),
        Position = UDim2.fromOffset(44, 6),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Notification",
        TextColor3 = T.Text,
        TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Font = FONT,
        TextSize = 11,
        ZIndex = 1001,
        Parent = card,
    })

    local cLbl = create("TextLabel", {
        Size = UDim2.new(1, -50, 0, 14),
        Position = UDim2.fromOffset(44, 22),
        BackgroundTransparency = 1,
        Text = cfg.Content or "",
        TextColor3 = T.SubText,
        TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Font = FONT_MED,
        TextSize = 10,
        ZIndex = 1001,
        Parent = card,
    })

    for _, o in ipairs({ card }) do
        TweenService:Create(o, TWEEN, { BackgroundTransparency = 0 }):Play()
    end
    TweenService:Create(icon, TWEEN, { ImageTransparency = 0 }):Play()
    TweenService:Create(tLbl, TWEEN, { TextTransparency = 0 }):Play()
    TweenService:Create(cLbl, TWEEN, { TextTransparency = 0 }):Play()

    task.delay(cfg.Duration or 2.5, function()
        if not card.Parent then return end
        TweenService:Create(card, FAST, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(icon, FAST, { ImageTransparency = 1 }):Play()
        TweenService:Create(tLbl, FAST, { TextTransparency = 1 }):Play()
        TweenService:Create(cLbl, FAST, { TextTransparency = 1 }):Play()
        task.wait(0.2)
        card:Destroy()
    end)
end

