    end)

    return { Value = value, Set = function(_, v)
        value = v
        btn.Text = tostring(v) .. " ▾"
        if cfg.ConfigKey then
            self.Win.State.configs[cfg.ConfigKey] = v
            self.Win._save()
        end
        if cfg.Callback then task.spawn(cfg.Callback, v) end
    end }
end

function Tab:AddKeybind(cfg)
    cfg = cfg or {}
    local value = cfg.Default or Enum.KeyCode.RightShift
    if cfg.ConfigKey and self.Win.State.configs[cfg.ConfigKey] then
        local ok = pcall(function()
            value = Enum.KeyCode[self.Win.State.configs[cfg.ConfigKey]]
        end)
    end
    local frame = makeRow(self, cfg.Name, self._nextOrderFn(), 36)
    local T = self.Win.Theme

    local btn = create("TextButton", {
        Size = UDim2.fromOffset(80, 22),
        Position = UDim2.new(1, -88, 0.5, -11),
        BackgroundColor3 = T.Text,
        Text = value.Name,
        TextColor3 = T.Background,
        Font = FONT,
        TextSize = 10,
        AutoButtonColor = false,
        Parent = frame,
    }, { corner(6) })
    self._regRefresh(function()
        btn.BackgroundColor3 = T.Text
        btn.TextColor3 = T.Background
    end)

    local listening = false
    btn.MouseButton1Click:Connect(function()
        listening = true
        btn.Text = "..."
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                value = input.KeyCode
                btn.Text = value.Name
                listening = false
                if cfg.ConfigKey then
                    self.Win.State.configs[cfg.ConfigKey] = value.Name
                    self.Win._save()
                end
                if cfg.Callback then task.spawn(cfg.Callback, value) end
            end
        else
            if input.KeyCode == value and cfg.Callback then
                task.spawn(cfg.Callback, value)
            end
        end
    end)

    return { Value = value, Set = function(_, v)
        value = v
        btn.Text = v.Name
        if cfg.ConfigKey then
            self.Win.State.configs[cfg.ConfigKey] = v.Name
            self.Win._save()
        end
    end }
end

function Tab:AddInfoRow(cfg)
    cfg = cfg or {}
    local T = self.Win.Theme
    local f = create("Frame", {
        Size = UDim2.new(1, -4, 0, 34),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        LayoutOrder = self._nextOrderFn(),
        Active = true,
        Parent = self.Page,
    }, { corner(8), mkStroke(T.Border, 1, 0.3) })
    self._reg(f, "BackgroundColor3", "Element")
    self._reg(f:FindFirstChildOfClass("UIStroke"), "Color", "Border")

    if cfg.Icon then
        local isUrl = tostring(cfg.Icon):lower():find("rbxassetid") or tostring(cfg.Icon):lower():find("rbxthumb")
        if isUrl then
            create("ImageLabel", {
                Size = UDim2.fromOffset(18, 18),
                Position = UDim2.fromOffset(9, 8),
                BackgroundTransparency = 1,
                Image = cfg.Icon,
                ImageColor3 = Color3.new(1, 1, 1),
                ScaleType = Enum.ScaleType.Fit,
                ZIndex = 2,
                Parent = f,
            })
        else
            create("TextLabel", {
                Size = UDim2.fromOffset(22, 18),
                Position = UDim2.fromOffset(8, 8),
                BackgroundTransparency = 1,
                Text = cfg.Icon,
                TextColor3 = T.Text,
                Font = FONT,
                TextSize = 12,
                ZIndex = 2,
                Parent = f,
            })
        end
    end

    local lbl = create("TextLabel", {
        Size = UDim2.new(0, 70, 0, 18),
        Position = UDim2.fromOffset(34, 8),
        BackgroundTransparency = 1,
        Text = cfg.Label or "",
        TextColor3 = T.SubText,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Font = FONT_MED,
        TextSize = 10,
        Parent = f,
    })
    self._reg(lbl, "TextColor3", "SubText")

    local valLbl = create("TextLabel", {
        Size = UDim2.new(1, cfg.Copyable and -160 or -110, 0, 18),
        Position = UDim2.fromOffset(106, 8),
        BackgroundTransparency = 1,
        Text = tostring(cfg.Value or ""),
        TextColor3 = T.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Font = FONT,
        TextSize = 10,
        Parent = f,
    })
    self._reg(valLbl, "TextColor3", "Text")

    local handle = { Value = cfg.Value, Set = function(_, v)
        valLbl.Text = tostring(v)
    end }

    if cfg.Copyable then
        local copyBtn = create("TextButton", {
            Size = UDim2.fromOffset(48, 20),
            Position = UDim2.new(1, -54, 0.5, -10),
            BackgroundColor3 = T.Text,
            Text = "COPY",
            TextColor3 = T.Background,
            Font = FONT,
            TextSize = 9,
            AutoButtonColor = false,
            Parent = f,
        }, { corner(6) })
        self._regRefresh(function()
            copyBtn.BackgroundColor3 = T.Text
            copyBtn.TextColor3 = T.Background
        end)

        copyBtn.MouseButton1Click:Connect(function()
            local ok = setClipboard(cfg.Value or valLbl.Text)
            copyBtn.Text = "✓ OK"
            task.delay(1, function()
                if copyBtn.Parent then copyBtn.Text = "COPY" end
            end)
            if cfg.OnCopy then
                task.spawn(cfg.OnCopy, ok)
            end
        end)
    end

    return handle
end

-- Mount tab methods onto returned object
function Window:_MountTabMethods(tabObj)
    for k, v in pairs(Tab) do
        tabObj[k] = v
    end
end

