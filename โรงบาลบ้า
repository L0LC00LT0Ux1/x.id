local function resolveWeaponInfo(inst)
    if not inst or not inst.Parent then return nil, nil end
    if inst:IsA("GuiObject") or inst:IsA("LayerCollector") then return nil, nil end
    if inst:IsA("Sound") or inst:IsA("Light") or inst:IsA("ParticleEmitter")
        or inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("Attachment") then
        return nil, nil
    end
    if inst:IsA("Tool") then return inst.Name, inst end
    local tool = inst:FindFirstChildWhichIsA("Tool", true)
    if tool and not isGenericName(tool.Name) then return tool.Name, tool end
    if not isGenericName(inst.Name) and inst:IsA("Model") then return inst.Name, inst end
    if not isGenericName(inst.Name) and inst:IsA("BasePart") then return inst.Name, inst end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("BasePart") and not isGenericName(d.Name) then return d.Name, inst end
    end
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text and d.Text ~= "" and d.Text ~= "Label" then
            if not isGenericName(d.Text) then return d.Text, inst end
        end
    end
    local a = inst:GetAttribute("WeaponName") or inst:GetAttribute("ItemName")
        or inst:GetAttribute("DisplayName") or inst:GetAttribute("Name")
    if a and tostring(a) ~= "" and not isGenericName(tostring(a)) then return tostring(a), inst end
    if isGenericName(inst.Name) and inst.Parent and not isGenericName(inst.Parent.Name) then
        if inst.Parent:IsA("Model") or inst.Parent:IsA("Folder") then
            local pn = inst.Parent.Name
            if pn ~= "CrutchSpawns" and pn ~= "ContrabandSpawners"
               and pn ~= "Ignored" and pn ~= "Workspace" then
                return pn, inst
            end
        end
    end
    return inst.Name, inst
end

local RANGE_ATTRS = {"Range","HitRange","AttackRange","Reach","HitboxRange","SwingRange","MeleeRange"}
local SPEED_ATTRS = {"AttackSpeed","Speed","Cooldown","AttackCooldown","SwingSpeed","Rate","Delay"}
local function getToolAttackRange(tool)
    if not tool then return CFG.SMART_TOOL_DEFAULT_RANGE end
    for _, attr in ipairs(RANGE_ATTRS) do
        local v = tool:GetAttribute(attr)
        if typeof(v) == "number" and v > 0 then return v end
    end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") then
            local ln = d.Name:lower()
            if ln:find("hitbox") or ln:find("hit") or ln:find("range") then
                local sz = d.Size
                local m = math.max(sz.X, sz.Y, sz.Z)
                if m > 0.1 then return m * 1.2 + 2 end
            end
        end
    end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("NumberValue") then
            local ln = d.Name:lower()
            if ln:find("range") or ln:find("reach") then
                if d.Value > 0 then return d.Value end
            end
        end
    end
    return CFG.SMART_TOOL_DEFAULT_RANGE
end
local function getToolAttackSpeed(tool)
    if not tool then return CFG.SMART_TOOL_DEFAULT_SPEED end
    for _, attr in ipairs(SPEED_ATTRS) do
        local v = tool:GetAttribute(attr)
        if typeof(v) == "number" and v > 0 then return v end
    end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("NumberValue") then
            local ln = d.Name:lower()
            if ln:find("speed") or ln:find("cooldown") or ln:find("rate") or ln:find("delay") then
                if d.Value > 0 then return d.Value end
            end
        end
    end
    return CFG.SMART_TOOL_DEFAULT_SPEED
end

