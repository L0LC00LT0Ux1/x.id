local function loadConfig()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return end
    if not isfile(SAVE_FILE) then return end
    local ok, content = pcall(readfile, SAVE_FILE)
    if not ok or not content then return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or type(data) ~= "table" then return end
    for k, v in pairs(data) do
        if k == "miniFuncs" and type(v) == "table" then
            for kk, vv in pairs(v) do if S.miniFuncs[kk] ~= nil then S.miniFuncs[kk] = vv end end
        elseif k == "miniPositions" and type(v) == "table" then
            S.miniPositions = {}
            for kk, vv in pairs(v) do
                if type(vv) == "table" and type(vv[1]) == "number" and type(vv[2]) == "number" then
                    S.miniPositions[kk] = UDim2.new(vv[1], vv[2], vv[3] or 0, vv[4] or 0)
                end
            end
        elseif k == "lockTeamFilter" and type(v) == "table" then
            S.lockTeamFilter = {}
            for kk, vv in pairs(v) do S.lockTeamFilter[kk] = vv end
        elseif k == "whitelist" and type(v) == "table" then
            S.whitelist = {}
            for kk, vv in pairs(v) do S.whitelist[kk] = vv end
        elseif k == "autoToolRange" then
            S.autoToolRange = math.clamp(v, CFG.AUTO_TOOL_RANGE_MIN, CFG.AUTO_TOOL_RANGE_MAX)
            CFG.AUTO_TOOL_RANGE = S.autoToolRange
        elseif k == "speedValue" then
            S.speedValue = math.clamp(v, CFG.SPEED_MIN, CFG.SPEED_MAX)
        elseif k == "detainRange" then
            S.detainRange = math.clamp(v, 0.5, 20)
        elseif k == "guiSize" and GUI_SIZES[v] then
            S.guiSize = v
        elseif S[k] ~= nil then
            S[k] = v
        end
    end
end
