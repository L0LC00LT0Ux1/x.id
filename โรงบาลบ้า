local function updateCircle()
    if S.stopped or not S.espAutoToolOn or S.choice ~= "help" then
        if S.circlePart then pcall(function() S.circlePart:Destroy() end); S.circlePart = nil end
        return
    end
    local root = getRoot(); if not root then return end
    if not S.circlePart or not S.circlePart.Parent then
        local p = Instance.new("Part")
        p.Name = "TOU_RangeCircle"; p.Shape = Enum.PartType.Cylinder
        p.Anchored = true; p.CanCollide = false; p.CanTouch = false
        pcall(function() p.CanQuery = false end)
        p.Transparency = 0.5; p.Color = Color3.fromRGB(255,30,30)
        p.Material = Enum.Material.Neon
        p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
        p.Parent = Workspace; S.circlePart = p
    end
    local radius
    if S.smartToolOn then
        local char = player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        radius = getToolAttackRange(tool)
    else
        radius = math.max(CFG.AUTO_TOOL_RANGE_MIN, math.min(CFG.AUTO_TOOL_RANGE_MAX, S.autoToolRange))
    end
    S.circlePart.Size = Vector3.new(0.2, radius * 2, radius * 2)
    local rayOrigin = Vector3.new(root.Position.X, root.Position.Y + 8, root.Position.Z)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character, S.circlePart }
    local result = Workspace:Raycast(rayOrigin, Vector3.new(0,-200,0), params)
    local groundY = (result and result.Position.Y) or (root.Position.Y - 3)
    S.circlePart.CFrame = CFrame.new(root.Position.X, groundY + 0.12, root.Position.Z) * CFrame.Angles(0,0,math.rad(90))
end
track(RunService.Heartbeat:Connect(function()
    if S.espAutoToolOn then updateCircle() end
end))

