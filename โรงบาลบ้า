local BASE_SPEED = CFG.SPEED_BASE
track(RunService.Heartbeat:Connect(function(dt)
    if S.stopped or not S.speedOn or S.choice ~= "help" then return end
    local hum = getHum(); local root = getRoot()
    if not hum or not root then return end
    local target = math.clamp(S.speedValue, CFG.SPEED_MIN, CFG.SPEED_MAX)
    if hum.WalkSpeed ~= BASE_SPEED then hum.WalkSpeed = BASE_SPEED end
    local extra = target - BASE_SPEED
    if extra <= 0 then return end
    local dir = hum.MoveDirection
    if dir.Magnitude < 0.1 then return end
    local step = dir.Unit * extra * math.min(dt, 0.06)
    pcall(function() root.CFrame = root.CFrame + step end)
end))
