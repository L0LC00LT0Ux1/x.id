local function computePath(dest)
    local ok1, path = pcall(function()
        return PathfindingService:CreatePath({ AgentRadius = CFG.AGENT_RADIUS, AgentHeight = CFG.AGENT_HEIGHT,
            AgentCanJump = true, AgentCanClimb = false })
    end)
    if not ok1 or not path then return nil end
    local root = getRoot(); if not root then return nil end
    local ok2 = pcall(function() path:ComputeAsync(root.Position, dest) end)
    if ok2 and path.Status == Enum.PathStatus.Success then return path end
    return nil
end
local function smartWalkTo(dest, stopDist, shouldContinue, onTick)
    stopDist = stopDist or 3
    local hum = getHum(); if not hum then return false end
    local path = computePath(dest)
    local waypoints = (path and path:GetWaypoints()) or { { Position = dest, Action = Enum.PathWaypointAction.Walk } }
    local idx = 1
    local lastPos = getRoot() and getRoot().Position
    local stuckClock = os.clock(); local stuckCount = 0
    while shouldContinue() do
        while S.lookingAt and shouldContinue() do task.wait(0.1) end
        if not shouldContinue() then return false end
        local root = getRoot(); if not root then return false end
        local dDest = (root.Position - dest).Magnitude
        if onTick then onTick(dDest) end
        if dDest <= stopDist then hum:MoveTo(root.Position); return true end
        if idx > #waypoints then
            path = computePath(dest)
            waypoints = (path and path:GetWaypoints()) or { { Position = dest, Action = Enum.PathWaypointAction.Walk } }
            idx = 1
            if #waypoints == 0 then return false end
        end
        local wp = waypoints[idx]
        if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
        hum:MoveTo(wp.Position)
        local moveStart = os.clock()
        while shouldContinue() do
            if S.lookingAt then break end
            if os.clock() - moveStart > CFG.WAYPOINT_TIMEOUT then break end
            root = getRoot(); if not root then return false end
            local dwp = (root.Position - wp.Position).Magnitude
            local d2 = (root.Position - dest).Magnitude
            if onTick then onTick(d2) end
            if d2 <= stopDist then hum:MoveTo(root.Position); return true end
            if dwp <= CFG.LOOKAHEAD_DIST then break end
            if lastPos and (root.Position - lastPos).Magnitude < 0.15 then
                if os.clock() - stuckClock > CFG.STUCK_TIME then
                    stuckClock = os.clock(); stuckCount = stuckCount + 1
                    if stuckCount < CFG.STUCK_TELEPORT_AFTER then hum.Jump = true
                    else
                        stuckCount = 0; hum.Jump = true
                        teleportToward(dest, CFG.STUCK_TELEPORT_DIST)
                        task.wait(0.1)
                        path = computePath(dest)
                        waypoints = (path and path:GetWaypoints()) or { { Position = dest, Action = Enum.PathWaypointAction.Walk } }
                        idx = 0; break
                    end
                end
            else stuckClock = os.clock(); stuckCount = 0 end
            lastPos = root.Position
            task.wait()
        end
        idx = idx + 1
    end
    return false
end
local function fireNearestPrompt()
    local root = getRoot(); if not root then return false end
    local best, bestDist = nil, math.huge
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local part = d.Parent
            local pos = part and (part:IsA("BasePart") and part.Position or modelPos(part))
            if pos then
                local dist = (pos - root.Position).Magnitude
                if dist < bestDist then best, bestDist = d, dist end
            end
        end
    end
    if not best then return false end
    if typeof(fireproximityprompt) == "function" then return pcall(fireproximityprompt, best) end
    return false
end
