local function tweenToPosition(target, speed, noclipOn, my)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not root then return false end

    if noclipOn then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then pcall(function() part.CanCollide = false end) end
        end
        pcall(function() hum.WalkSpeed = 0 end)
        pcall(function() hum.AutoRotate = false end)
    end

    local startDist = (root.Position - target).Magnitude
    local dur = math.max(startDist / speed, 0.05)
    local dir = target - root.Position
    local flat = Vector3.new(dir.X, 0, dir.Z)
    local lookAt = flat.Magnitude > 0.05 and (target + flat) or (target + dir)
    local targetCF = CFrame.new(target, lookAt)

    local tw = TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = targetCF })
    S.escapeTween = tw
    S.escapeMoving = true
    tw:Play()

    local finished = false
    local con
    con = tw.Completed:Connect(function() finished = true end)
    local t0 = os.clock()
    while isAlive(my) and not finished do
        if os.clock() - t0 > 60 then break end
        if player.Character ~= char then break end
        task.wait(0.05)
    end
    if con then con:Disconnect() end
    S.escapeTween = nil
    S.escapeMoving = false

    local rf = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if rf then
        pcall(function() rf.CFrame = CFrame.new(target) end)
    end

    if noclipOn and player.Character == char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then pcall(function() part.CanCollide = true end) end
        end
        pcall(function() hum.WalkSpeed = CFG.WALK_SPEED end)
        pcall(function() hum.AutoRotate = true end)
    end
    return true
end

local function runEscapeLoop()
    local function stillOn() return (not S.stopped) and S.choice == "escape" end
    local routeKey = S.escapeRoute or "a"
    local my = S.token

    while stillOn() do
        local char = player.Character
        if not char then
            local ok = pcall(function() char = player.CharacterAdded:Wait() end)
            if not ok then task.wait(1) continue end
        end
        local hum = char and char:WaitForChild("Humanoid", 10)
        local root = char and char:WaitForChild("HumanoidRootPart", 10)
        if not hum or not root then task.wait(1) continue end
        if hum.Health <= 0 then pcall(function() player.CharacterAdded:Wait() end); task.wait(1) continue end
        hum.AutoRotate = false; S.escapeMoving = false

        local activeRouteKey = routeKey
        local supportCon = startEscapeSupport(stillOn)
        local died = false
        local deathConn = hum.Died:Connect(function()
            died = true; S.escapeMoving = false
            if S.escapeTween then pcall(function() S.escapeTween:Cancel() end) end
        end)

        -- SPECIAL FLOW: Route C
        if activeRouteKey == "c" then
            local hideout = CFG.ESCAPE_ROUTE_C_HIDEOUT
            while stillOn() and not died do
                local routeC = CFG.ESCAPE_ROUTES.c
                local i = 1
                local needSwitch = false
                while stillOn() and not died and i <= #routeC do
                    local pos = routeC[i]
                    if S.escapeAutoSwitch then
                        local safe = pointIsSafe(pos, CFG.ESCAPE_AVOID_RANGE)
                        if not safe then
                            local newKey = findSafestRouteAt(i, "c")
                            if newKey then
                                activeRouteKey = newKey
                                needSwitch = true
                                break
                            end
                        end
                    end
                    local c2 = player.Character
                    local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
                    if not r2 then break end
                    local startDist = (r2.Position - pos).Magnitude
                    -- ✅ Speed: waypoint 1 = 80, waypoint >= 10 = 40, อื่นๆ = 30
                    local wpSpeed = CFG.ESCAPE_SPEED
                    if i == 1 then
                        wpSpeed = CFG.ESCAPE_ROUTE_C_HIDEOUT_SPEED
                    elseif i >= CFG.ESCAPE_ROUTE_C_FAST_START_IDX then
                        wpSpeed = CFG.ESCAPE_ROUTE_C_FAST_SPEED
                    end
                    local dur = math.max(startDist / wpSpeed, 0.05)
                    local dir = pos - r2.Position
                    local flat = Vector3.new(dir.X, 0, dir.Z)
                    local lookAt = flat.Magnitude > 0.05 and (pos + flat) or (pos + dir)
                    local targetCF = CFrame.new(pos, lookAt)
                    S.escapeMoving = true
                    S.escapeTween = TweenService:Create(r2, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = targetCF })
                    S.escapeTween:Play()
                    local finished, pulledBack = false, false
                    local con
                    con = S.escapeTween.Completed:Connect(function() finished = true end)
                    local lastDist = startDist
                    while stillOn() and not finished and not died do
                        task.wait()
                        local rr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                        if not rr then break end
                        local curDist = (rr.Position - pos).Magnitude
                        if curDist - lastDist > CFG.ESCAPE_PULLBACK_THRESHOLD then pulledBack = true; break end
                        lastDist = curDist
                    end
                    con:Disconnect(); S.escapeMoving = false
                    if died or not stillOn() then break end
                    if pulledBack then
                        if S.escapeTween then pcall(function() S.escapeTween:Cancel() end) end
                        S.escapeTween = nil
                        task.wait(CFG.ESCAPE_PULLBACK_COOLDOWN)
                        local rr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                        if rr then i = nearestEscapePointIndex(rr.Position, routeC) end
                    else
                        S.escapeTween = nil; i = i + 1
                    end
                end
                if died or not stillOn() then break end
                if needSwitch then break end

                -- ✅ ถ้า END_WAIT > 0 ค่อยรอ / ถ้า 0 ข้ามไปวาป hideout ทันที
                if CFG.ESCAPE_ROUTE_C_END_WAIT > 0 then
                    local t0 = os.clock()
                    while stillOn() and not died and os.clock() - t0 < CFG.ESCAPE_ROUTE_C_END_WAIT do
                        task.wait(0.5)
                    end
                    if died or not stillOn() then break end
                end

                tweenToPosition(hideout, CFG.ESCAPE_ROUTE_C_HIDEOUT_SPEED, true, my)
                if died or not stillOn() then break end

                ensureHideoutPlatform(hideout)

                -- ✅ รอ 60 วิ ที่ hideout
                local t1 = os.clock()
                while stillOn() and not died and os.clock() - t1 < CFG.ESCAPE_ROUTE_C_HIDEOUT_WAIT do
                    task.wait(0.5)
                end
                destroyHideoutPlatform()
                if died or not stillOn() then break end
            end
        end

        -- NORMAL FLOW (A / B)
        if stillOn() and not died and activeRouteKey ~= "c" then
            local completedAll = true
            local i = 1
            while stillOn() and not died do
                local activeRoute = CFG.ESCAPE_ROUTES[activeRouteKey]
                if not activeRoute or i > #activeRoute then break end
                local pos = activeRoute[i]

                if S.escapeAutoSwitch and pos then
                    local safe = pointIsSafe(pos, CFG.ESCAPE_AVOID_RANGE)
                    if not safe then
                        local newKey = findSafestRouteAt(i, activeRouteKey)
                        if newKey then
                            activeRouteKey = newKey
                            local r2 = CFG.ESCAPE_ROUTES[activeRouteKey]
                            pos = r2[i] or pos
                        end
                    end
                end

                local c = player.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if not r then completedAll = false; break end
                local startDist = (r.Position - pos).Magnitude
                local dur = math.max(startDist / CFG.ESCAPE_SPEED, 0.05)
                local dir = pos - r.Position
                local flat = Vector3.new(dir.X, 0, dir.Z)
                local lookAt = flat.Magnitude > 0.05 and (pos + flat) or (pos + dir)
                local targetCF = CFrame.new(pos, lookAt)
                S.escapeMoving = true
                S.escapeTween = TweenService:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = targetCF })
                S.escapeTween:Play()
                local finished, pulledBack = false, false
                local con
                con = S.escapeTween.Completed:Connect(function() finished = true end)
                local lastDist = startDist
                while stillOn() and not finished and not died do
                    task.wait()
                    local rr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if not rr then break end
                    local curDist = (rr.Position - pos).Magnitude
                    if curDist - lastDist > CFG.ESCAPE_PULLBACK_THRESHOLD then pulledBack = true; break end
                    lastDist = curDist
                end
                con:Disconnect(); S.escapeMoving = false
                if died or not stillOn() then completedAll = false; break end
                if pulledBack then
                    if S.escapeTween then pcall(function() S.escapeTween:Cancel() end) end
                    S.escapeTween = nil
                    task.wait(CFG.ESCAPE_PULLBACK_COOLDOWN)
                    local rr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if rr then i = nearestEscapePointIndex(rr.Position, CFG.ESCAPE_ROUTES[activeRouteKey]) end
                else
                    S.escapeTween = nil
                    i = i + 1
                end
            end
            if completedAll and stillOn() and not died then
                local t0 = os.clock()
                while stillOn() and not died and os.clock() - t0 < CFG.ESCAPE_HOLD_TIME do task.wait(0.5) end
            end
        end

        if died then
            while stillOn() do
                local c = player.Character
                local h = c and c:FindFirstChild("Humanoid")
                if h and h.Health > 0 then task.wait(0.5); break end
                task.wait(0.5)
            end
        end

        if supportCon then supportCon:Disconnect() end
        deathConn:Disconnect()
        destroyHideoutPlatform()
    end
    local hum = getHum(); if hum then hum.AutoRotate = true end
    local char = player.Character
