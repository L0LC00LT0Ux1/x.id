-- ✅ รับ speed เป็น parameter
local function teleportWaypoints(my, waypoints, speed)
    if not waypoints or #waypoints == 0 then return false end
    speed = speed or CFG.FARM_TP_SPEED
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not root then return false end

    setCharCollide(char, false)
    pcall(function() hum.AutoRotate = false end)
    local prevWS = hum.WalkSpeed
    hum.WalkSpeed = 0

    local ok = true
    for idx, target in ipairs(waypoints) do
        if not isAlive(my) then ok = false; break end
        local c2 = player.Character
        local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
        if not c2 or not r2 then ok = false; break end

        local startDist = (r2.Position - target).Magnitude
        local dur = math.max(startDist / speed, CFG.FARM_TP_MIN_DUR)  -- ✅ ใช้ speed ที่รับมา

        local dir = target - r2.Position
        local flat = Vector3.new(dir.X, 0, dir.Z)
        local lookAt = flat.Magnitude > 0.05 and (target + flat) or (target + dir)
        local targetCF = CFrame.new(target, lookAt)

        local tw = TweenService:Create(r2, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = targetCF })
        S.farmTween = tw
        tw:Play()

        local finished = false
        local con
        con = tw.Completed:Connect(function() finished = true end)
        local t0 = os.clock()
        while isAlive(my) and not finished do
            if os.clock() - t0 > 30 then break end
            if player.Character ~= c2 then ok = false; break end
            task.wait(0.05)
        end
        if con then con:Disconnect() end
        S.farmTween = nil

        if not ok or not isAlive(my) then break end

        if idx == #waypoints then
            local cf = player.Character
            local rf = cf and cf:FindFirstChild("HumanoidRootPart")
            if rf then
                pcall(function() rf.CFrame = CFrame.new(target) end)
                task.wait(0.05)
                if rf.Parent then pcall(function() rf.CFrame = CFrame.new(target) end) end
            end
        end
    end

    if player.Character == char then
        setCharCollide(char, true)
        pcall(function() hum.AutoRotate = true end)
        pcall(function() hum.WalkSpeed = prevWS end)
    end
    return ok
end

local function equipHealToolCycle()
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return false, nil end

    local heldName
    for _, tn in ipairs(CFG.HEAL_TOOLS) do
        if char:FindFirstChild(tn) then heldName = tn; break end
    end

    if not heldName then S.farmToolIndex = 1 end

    for attempt = 0, #CFG.HEAL_TOOLS - 1 do
        local idx = ((S.farmToolIndex - 1 + attempt) % #CFG.HEAL_TOOLS) + 1
        local tn = CFG.HEAL_TOOLS[idx]
        local t = bp and bp:FindFirstChild(tn)
        if not t then t = char:FindFirstChild(tn) end
        if t and t:IsA("Tool") then
            pcall(function() hum:UnequipTools() end)
            task.wait(0.05)
            pcall(function() hum:EquipTool(t) end)
            local t0 = os.clock()
            while os.clock() - t0 < CFG.FARM_EQUIP_TIMEOUT do
                if char:FindFirstChild(tn) then
                    S.farmToolIndex = (idx % #CFG.HEAL_TOOLS) + 1
                    return true, tn
                end
                task.wait(0.05)
            end
        end
    end
    return false, nil
end

local function runFarmRoutine(my, role)
    if not isAlive(my) then return end
    if S.farmRunning then return end
    S.farmRunning = true

    -- ✅ แยก speed target(85) / healer(40)
    local isTarget = (role == "target")
    local waypoints = isTarget and CFG.FARM_TARGET_WAYPOINTS or CFG.FARM_HEALER_WAYPOINTS
    local tpSpeed   = isTarget and CFG.FARM_TP_SPEED_TARGET or CFG.FARM_TP_SPEED
    teleportWaypoints(my, waypoints, tpSpeed)
    if not isAlive(my) then S.farmRunning = false; return end

    if role == "target" then
        local lastPoint = waypoints[#waypoints]
        while isAlive(my) do
            pcall(function()
                local r = getRoot()
                local h = getHum()
                if r and h then
                    local d = (r.Position - lastPoint).Magnitude
                    if d > CFG.FARM_KEEP_NEAR then
                        task.spawn(function()
                            if not S.farmRunning then return end
                            S.farmRunning = false
                            task.wait(0.1)
                            runFarmRoutine(my, role)
                        end)
                    else
                        h:MoveTo(r.Position)
                    end
                end
            end)
            task.wait(0.5)
        end
    elseif role == "healer" then
        local lastPoint = waypoints[#waypoints]
        local lastCheck = os.clock()
        while isAlive(my) do
            pcall(function()
                local char = player.Character
                local hum2 = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not hum2 or not root then return end

                local best, bestDist = nil, math.huge
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= player and plr.Character then
                        local h = plr.Character:FindFirstChildOfClass("Humanoid")
                        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        if h and hrp and h.Health > 0 and h.Health < h.MaxHealth then
                            local d = (root.Position - hrp.Position).Magnitude
                            if d <= CFG.FARM_HEAL_RANGE and d < bestDist then
                                best, bestDist = plr, d
                            end
                        end
                    end
                end

                if best then
                    local okEquip = equipHealToolCycle()
                    if okEquip then
                        task.wait(0.08)
                        if HealRemote then pcall(function() HealRemote:FireServer(best) end) end
                        task.wait(CFG.FARM_HEAL_DELAY)
                        task.wait(CFG.FARM_SWITCH_DELAY)
                    else
                        if HealRemote then pcall(function() HealRemote:FireServer(best) end) end
                        task.wait(CFG.FARM_HEAL_DELAY)
                    end
                    S.farmLastTarget = best
                    return
                else
                    S.farmLastTarget = nil
                end
                task.wait(CFG.FARM_SCAN_INTERVAL)
            end)
            if isAlive(my) and os.clock() - lastCheck > 8 then
                local r = getRoot()
                if r and (r.Position - lastPoint).Magnitude > 30 then
                    task.spawn(function()
                        S.farmRunning = false
                        task.wait(0.1)
                        runFarmRoutine(my, role)
                    end)
                    break
                end
                lastCheck = os.clock()
            end
        end
    end
    S.farmRunning = false
end

