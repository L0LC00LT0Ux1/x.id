local function getNilByNameNear(name, pos, tol)
    if typeof(getnilinstances) ~= "function" then return nil end
    local ok, list = pcall(getnilinstances); if not ok then return nil end
    local best, bestDist = nil, tol
    for _, obj in ipairs(list) do
        if obj.Name == name then
            local p = modelPos(obj)
            if p then
                local d = (p - pos).Magnitude
                if d <= bestDist then best, bestDist = obj, d end
            end
        end
    end
    return best
end
local function fireCleanSpill(spillModel)
    local pos = modelPos(spillModel); if not pos then return false end
    local nilObj = getNilByNameNear(spillModel.Name, pos, CFG.CLEAN_REMOTE_TOLERANCE) or spillModel
    return pcall(function()
        local rf = ReplicatedStorage:WaitForChild("Remote", 5)
        local ev = rf and rf:WaitForChild("AttemptCleanSpill", 5)
        if not ev then error("AttemptCleanSpill not found") end
        ev:FireServer(nilObj)
    end)
