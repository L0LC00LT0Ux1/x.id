local function scanWeaponFolders()
    local found = {}
    for _, path in ipairs(CFG.WEAPON_PATHS) do
        local folder = resolvePath(Workspace, path)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if not child:IsA("GuiObject") and not child:IsA("Sound") and not child:IsA("LayerCollector") then
                    local hasPart = child:IsA("BasePart")
                    if not hasPart then hasPart = child:FindFirstChildWhichIsA("BasePart", true) ~= nil end
                    if hasPart then found[child] = true end
                end
            end
        end
    end
    return found
end
local function refreshWeaponESP()
    local found = scanWeaponFolders()
    for inst in pairs(found) do
        if not weaponEspState[inst] then pcall(createWeaponESP, inst) end
    end
    local myRoot = getRoot()
    for inst, rec in pairs(weaponEspState) do
        if not inst.Parent or not found[inst] then
            destroyWeaponESP(inst)
        else
            local pos = modelPos(rec.realInst or inst)
            if pos and myRoot then
                local d = (myRoot.Position - pos).Magnitude
                if rec.distLbl and rec.distLbl.Parent then
                    rec.distLbl.Text = string.format("%.0f m", d)
                end
            end
            local disp = getWeaponDisplayName(rec.dispName or inst.Name)
            local newTxt = "⚔ " .. disp
            if rec.nameLbl and rec.nameLbl.Parent and rec.nameLbl.Text ~= newTxt then
                rec.nameLbl.Text = newTxt
            end
            if not rec.attach or not rec.attach.Parent then
                local r2 = rec.realInst or inst
                local newAttach
                if r2:IsA("BasePart") then newAttach = r2
                elseif r2:IsA("Model") then newAttach = r2.PrimaryPart or r2:FindFirstChildWhichIsA("BasePart", true) end
                if newAttach then
                    rec.attach = newAttach
                    if rec.bb and rec.bb.Parent ~= newAttach then
                        pcall(function() rec.bb.Parent = newAttach end)
                    end
                end
            end
        end
    end
end
local function purgeWeaponESP()
    for inst in pairs(weaponEspState) do destroyWeaponESP(inst) end
    for i = #weaponESP_createdList, 1, -1 do
        local obj = weaponESP_createdList[i]
        if obj then pcall(function() obj:Destroy() end) end
        weaponESP_createdList[i] = nil
    end
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d.Name == "TOU_WESP" or d.Name == "TOU_WBB" then
            pcall(function() d:Destroy() end)
        end
    end
end

local function getLockTarget()
    if not S.lockOn then return nil end
    local myRoot = getRoot(); if not myRoot then return nil end
    if S.lockNearestMode and S.lockNearestTarget and S.lockNearestTarget.Parent then
        local c = S.lockNearestTarget.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if h and h.Health > 0 and r and not isWhitelisted(S.lockNearestTarget) then
            return S.lockNearestTarget
        end
        S.lockNearestTarget = nil
    end
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and not isWhitelisted(plr) then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local teamKey = plr.Team and plr.Team.Name or "No Team"
                local allowed = not next(S.lockTeamFilter)
                if not allowed then
                    for k, v in pairs(S.lockTeamFilter) do
                        if v and k == teamKey then allowed = true; break end
                    end
                end
                if allowed then
                    local d = (myRoot.Position - hrp.Position).Magnitude
                    if d < bestDist then best, bestDist = plr, d end
                end
            end
        end
    end
    if best and S.lockNearestMode then S.lockNearestTarget = best end
    return best
end
