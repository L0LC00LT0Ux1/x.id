local function nearestSpill(folder, skipUntil)
    local root = getRoot(); if not root or not folder then return nil end
    local best, bestDist = nil, math.huge
    local now = os.clock()
    for _, m in ipairs(folder:GetChildren()) do
        if not (skipUntil and skipUntil[m] and now < skipUntil[m]) then
            local pos = modelPos(m)
            if pos then
                local d = (pos - root.Position).Magnitude
                if d < bestDist then best, bestDist = m, d end
            end
        end
    end
    return best
end
local function runMopRoutine(my)
    local function ok() return isAlive(my) end
    smartWalkTo(CFG.START_POS, 3, ok); if not ok() then return end
    fireNearestPrompt(); if not ok() then return end
    waitAndEquipMop(my); if not ok() then return end
    local spillsFolder = resolvePath(Workspace, CFG.SPILLS_PATH)
    local skipUntil = {}
    local curTarget, curStart, curTries = nil, 0, 0
    while ok() do
        spillsFolder = spillsFolder or resolvePath(Workspace, CFG.SPILLS_PATH)
        local target = spillsFolder and nearestSpill(spillsFolder, skipUntil)
        if not target then task.wait(CFG.SPILL_SCAN_INTERVAL)
        else
            if target ~= curTarget then curTarget, curStart, curTries = target, os.clock(), 0
            elseif os.clock() - curStart > CFG.SPILL_TIMEOUT then
                stopMop(); skipUntil[target] = os.clock() + CFG.SPILL_SKIP_DURATION
                curTarget = nil; task.wait(0.2); continue
            end
            local pos = modelPos(target)
            if pos then
                local budget = os.clock() + CFG.SPILL_TIMEOUT
                local function okBudget() return ok() and os.clock() < budget end
                local reached = smartWalkTo(pos, CFG.CLEAN_DIST, okBudget, function(dist)
                    if dist <= CFG.APPROACH_ANIM_DIST then playMop() end
                end)
                if not ok() then break end
                if not reached then
                    stopMop(); skipUntil[target] = os.clock() + CFG.SPILL_SKIP_DURATION
                    curTarget = nil; task.wait(0.2)
                else
                    fireCleanSpill(target); curTries = curTries + 1
                    task.wait(0.3); stopMop()
                    if curTries >= CFG.SPILL_MAX_CLEAN_TRIES then
                        skipUntil[target] = os.clock() + CFG.SPILL_SKIP_DURATION
                        curTarget = nil
                    end
                end
            end
        end
    end
    stopMop()
end

