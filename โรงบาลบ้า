local function teleportToward(pos, dist)
    local root = getRoot(); if not root then return false end
    local offset = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
    if offset.Magnitude < 0.05 then return false end
    local step = math.min(dist, offset.Magnitude)
    root.CFrame = CFrame.new(root.Position + offset.Unit * step)
    return true
end
