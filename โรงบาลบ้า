local function nearestEscapePointIndex(pos, points)
    local bestIdx, bestDist = 1, math.huge
    for idx, p in ipairs(points) do
        local d = (pos - p).Magnitude
        if d < bestDist then bestIdx, bestDist = idx, d end
    end
