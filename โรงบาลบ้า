local function stopAll()
    if S.stopped then return end
    S.stopped = true
    S.token = S.token + 1
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    pcall(function() if S.mopTrack then S.mopTrack:Stop(0.1) end end)
    pcall(function() if S.escapeTween then S.escapeTween:Cancel() end end)
    pcall(function() if S.farmTween then S.farmTween:Cancel() end end)
    pcall(function() if S.escapePlatform then S.escapePlatform:Destroy() end end)
    pcall(function() if S.escapeHideoutPart then S.escapeHideoutPart:Destroy() end end)
    pcall(function() if S.circlePart then S.circlePart:Destroy() end end)
    for plr in pairs(espState) do pcall(destroyESP, plr) end
    pcall(purgeWeaponESP)
    pcall(destroyMiniButtons)
    for _, g in ipairs(createdGuis) do
        pcall(function() g:Destroy() end)
    end
    createdGuis = {}
    pcall(function() if mainGui and mainGui.Parent then mainGui:Destroy() end end)
    pcall(function() if S.helpGui and S.helpGui.Parent then S.helpGui:Destroy() end end)
    pcall(function() if S.helpMiniToggle and S.helpMiniToggle.Parent then S.helpMiniToggle:Destroy() end end)
    pcall(function() if S.infoGui and S.infoGui.Parent then S.infoGui:Destroy() end end)
    local function cleanContainer(container)
        if not container then return end
        for _, g in ipairs(container:GetChildren()) do
            if g:IsA("ScreenGui") and (g.Name:match("^TOU_") or g.Name:match("^MopKit") or g.Name == "ADMIN_KICK") then
                pcall(function() g:Destroy() end)
            end
        end
    end
    pcall(function() cleanContainer(game:GetService("CoreGui")) end)
    pcall(function()
        local pg = player:FindFirstChild("PlayerGui")
        if pg then cleanContainer(pg) end
    end)
    S.helpGui = nil; S.helpMiniToggle = nil; S.helpFrame = nil
    S.infoGui = nil; S.infoTimerLabel = nil
    genv.__MopKit_Cleanup = nil
end

