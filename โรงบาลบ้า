local function runHelpRoutine(my)
    if not isAlive(my) then return end
    if S.helpGui and S.helpGui.Parent then return end
    buildHelpGui()
end

local function onCharacterAdded(char)
    if S.stopped then return end
    S.token = S.token + 1
    local my = S.token
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 10)
        local root = char:WaitForChild("HumanoidRootPart", 10)
        if not hum or not root or S.stopped or S.token ~= my then return end
        if not S._configLoaded then
            S._configLoaded = true
            pcall(loadConfig)
        end
        if not S.lang then
            S.lang = askLanguage(my) or "th"
            if not isAlive(my) then return end
        end
        if not S.choice then
            local picked = askChoice(my)
            if not isAlive(my) then return end
            S.choice = picked
            if S.choice == "escape" then
                local route, autoSwitch = askEscapeRoute(my)
                if not isAlive(my) then return end
                S.escapeRoute = route or "a"
                S.escapeAutoSwitch = autoSwitch or false
            elseif S.choice == "farm" then
                local role = askFarmRole(my)
                -- ✅ เก็บค่าเดิม / default target ถ้าตายตอนเลือกครั้งแรก
                S.farmRole = role or S.farmRole or "target"
                if not isAlive(my) then return end
            end
            if S.choice == "mop" or S.choice == "escape" then
                startInfoOverlay()
            end
        end
        if S.choice == "mop" then
            hum.WalkSpeed = CFG.WALK_SPEED
            loadMopAnim(hum)
            runMopRoutine(my)
        elseif S.choice == "escape" then
            if not S.escapeStarted then
                S.escapeStarted = true
                task.spawn(runEscapeLoop)
            end
        elseif S.choice == "help" then
            runHelpRoutine(my)
        elseif S.choice == "farm" then
            -- ✅ ถ้า S.farmRole ยังเป็น nil (ตายตอนเปิด GUI เลือกครั้งแรก) → ถามใหม่
            --    กันบั๊กวาปผิดเส้น (target กลายเป็น healer)
            if not S.farmRole then
                local role = askFarmRole(my)
                if not isAlive(my) then return end
                S.farmRole = role or "target"  -- default = target
            end
            S.farmRunning = false
            S.farmToolIndex = 1
            task.wait(0.3)
            if isAlive(my) and S.farmRole then
                task.spawn(function() runFarmRoutine(my, S.farmRole) end)
            end
        end
    end)
end

