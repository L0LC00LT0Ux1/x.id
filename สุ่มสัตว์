    local function setupAntiKnockback(char)
        if not char then return end
        local humanoid = char:WaitForChild("Humanoid", 5)
        local root = char:WaitForChild("HumanoidRootPart", 5)
        if not humanoid or not root then return end

        lastHealth = humanoid.Health

        if healthConn then healthConn:Disconnect() end
        healthConn = humanoid.HealthChanged:Connect(function(newHealth)
            if antiKnockbackEnabled and newHealth < lastHealth then
                local currentAnchored = root.Anchored
                root.Anchored = true
                task.delay(0.5, function()
                    if root and root.Parent then root.Anchored = currentAnchored end
                end)
            end
            lastHealth = newHealth
        end)
    end

