-- ════════ HELPERS ════════
local function findNil(name)
    if typeof(getnilinstances) ~= "function" then return nil end
    for _, o in ipairs(getnilinstances()) do if o.Name == name then return o end end
end

local function findNilDbg(name, id)
    if typeof(getnilinstances) ~= "function" then return nil end
    for _, o in ipairs(getnilinstances()) do if o.Name == name and o:GetDebugId() == id then return o end end
end

local function sellPet(name)
    for _, f in ipairs(PET_FOLDERS) do local p = f:FindFirstChild(name) if p then sellPetEvent:FireServer("sellPet", p) return true end end
    local n = findNil(name) if n then sellPetEvent:FireServer("sellPet", n) return true end return false
end

local function sellAura(name)
    for _, f in ipairs(AURA_FOLDERS) do local a = f:FindFirstChild(name) if a then sellPowerUpEvent:FireServer("sellPowerUp", a) return true end end
    local n = findNil(name) if n then sellPowerUpEvent:FireServer("sellPowerUp", n) return true end return false
end

local function sellPetDbg(name, id)
    for _, f in ipairs(PET_FOLDERS) do local p = f:FindFirstChild(name) if p then sellPetEvent:FireServer("sellPet", p) return true end end
    local n = findNilDbg(name, id) if n then sellPetEvent:FireServer("sellPet", n) return true end return false
end

local function sellAuraDbg(name, id)
    for _, f in ipairs(AURA_FOLDERS) do local a = f:FindFirstChild(name) if a then sellPowerUpEvent:FireServer("sellPowerUp", a) return true end end
    local n = findNilDbg(name, id) if n then sellPowerUpEvent:FireServer("sellPowerUp", n) return true end return false
end

local function scan30() for n,_ in pairs(SELL_PETS_30) do sellPet(n) end for n,_ in pairs(SELL_AURAS_30) do sellAura(n) end end
local function scan15() for n,id in pairs(SELL_PETS_15) do sellPetDbg(n,id) end for n,id in pairs(SELL_AURAS_15) do sellAuraDbg(n,id) end end
local function scan150()
    for n,id in pairs(SELL_PETS_150) do sellPetDbg(n,id) end
    if sellTitan then sellPetDbg(TITAN_REACTOR.Name, TITAN_REACTOR.DebugId) end
end

local function countPet(name)
    local count = 0
    for _, folder in ipairs(PET_FOLDERS) do
        for _, child in ipairs(folder:GetChildren()) do
            if child.Name == name then count = count + 1 end
        end
    end
    return count
end

local function tryEvolve(cfg)
    if evolving or not cfg.Enabled then return end
    local count = countPet(cfg.Target)
    if count >= cfg.Need then
        evolving = true
        EclipseLib:Notify({Title="🔄 Evolve", Content="กำลัง Evolve " .. cfg.Target .. "...", Duration=2, Type="info"})
        local ok = pcall(function() petEvolveEvent:FireServer("evolvePet", cfg.Target) end)
        if ok then
            EclipseLib:Notify({Title="✅ Evolve สำเร็จ", Content=cfg.Target .. " Evolved!", Duration=3, Type="success"})
        else
            EclipseLib:Notify({Title="❌ Evolve ล้มเหลว", Content=cfg.Target, Duration=3, Type="error"})
        end
        evolving = false
    end
end

local function roll30()
    local ok = pcall(function() openCrystalRemote:InvokeServer("openCrystal", CRYSTAL_30) end)
    if ok then task.delay(0.15, function() scan30() tryEvolve(EVOLVE_30) end) end
    return ok
end

