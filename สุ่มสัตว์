    local function updateStatsDisplay(playerName)
        local player = Players:FindFirstChild(playerName)
        if not player then
            EclipseLib:Notify({
                Title = "❌ ไม่พบผู้เล่น",
                Content = "ไม่พบผู้เล่นชื่อ " .. playerName,
                Duration = 2,
                Type = "error"
            })
            return
        end

        statsDisplayPlayer = playerName

        if not statsDisplayFrame then
            createStatsDisplay()
        end

        if statsUpdateConn then
            statsUpdateConn:Disconnect()
            statsUpdateConn = nil
        end

        local function refreshStats()
            if not statsDisplayFrame then return end

            local stats, boosts = getPlayerStats(player)

            for _, label in pairs(statsDisplayLabels) do
                label:Destroy()
            end
            statsDisplayLabels = {}

            local scrollFrame = statsDisplayFrame:FindFirstChild("ScrollFrame")
            if not scrollFrame then return end

            local titleLabel = statsDisplayFrame:FindFirstChild("Title")
            if titleLabel then
                titleLabel.Text = "📊 สถิติ: " .. player.Name
            end

            local statsData = {
                {"👤 ผู้เล่น", player.Name},
                {"⚡ ค่าพลังความไว", tostring(stats.Agility)},
                {"🛡️ ค่าพลังความทนทาน", tostring(stats.Durability)},
                {"⚔️ การฆ่า", tostring(stats.Kills)},
                {"💪 ค่าพลังกล้าม", tostring(stats.Strength)},
                {"🔄 รีเบิร์ด", tostring(stats.Rebirths)},
                {"😇 กรรมดี", tostring(stats.GoodKarma)},
                {"😈 กรรมชั่ว", tostring(stats.BadKarma)},
                {"🐾 ใส่สัตว์ได้", tostring(stats.MaxPetCapacity)},
                {"💎 เพชร", tostring(stats.Gems)},
                {"🥊 เข้าร่วมเวที", tostring(stats.Brawls)},
                {"🧪 บูสโปรตีน", #boosts > 0 and table.concat(boosts, ", ") or "ไม่มี"},
            }

            for _, data in ipairs(statsData) do
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, -10, 0, 32)
                label.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
                label.BackgroundTransparency = 0.15
                label.Text = data[1] .. ": " .. data[2]
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.TextScaled = true
                label.Font = Enum.Font.Gotham
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.Parent = scrollFrame

                local labelCorner = Instance.new("UICorner")
