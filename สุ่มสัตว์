-- ════════ FARMING HELPERS ════════
local function getMuscleEvent()
    return LocalPlayer:FindFirstChild("muscleEvent")
end

local function equipTool(toolName)
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    local tool = LocalPlayer.Backpack:FindFirstChild(toolName) or char:FindFirstChild(toolName)
    if tool then
        humanoid:EquipTool(tool)
        return true
    end
    return false
end

local function fireMuscle()
    local event = getMuscleEvent()
    if event then
        pcall(function()
            event:FireServer("rep")
        end)
    end
end

local function startFarming()
    if not farmTool then return end
    farmEnabled = true
    farmConn = RunService.Heartbeat:Connect(function()
        if not farmEnabled then return end
        if not equipTool(farmTool) then
            local char = LocalPlayer.Character
            if not char then return end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid then return end
            local tool = LocalPlayer.Backpack:FindFirstChild(farmTool) or char:FindFirstChild(farmTool)
            if tool then
                humanoid:EquipTool(tool)
            end
        end
        fireMuscle()
        task.wait(fastMode and 0.01 or 0.1)
    end)
end

local function stopFarming()
    farmEnabled = false
    if farmConn then
        farmConn:Disconnect()
        farmConn = nil
    end
end

local function stopRebirth()
    rebirthEnabled = false
    if rebirthConn then
        rebirthConn:Disconnect()
        rebirthConn = nil
    end
end

-- 🛠️ [MODIFIED] ปรับปรุงระบบ Auto Rebirth ให้ตรวจสอบค่า Rebirths ปัจจุบันและหยุดอัตโนมัติเมื่อครบเป้าหมาย
local function startRebirth()
    rebirthEnabled = true
    rebirthConn = RunService.Heartbeat:Connect(function()
        if not rebirthEnabled then return end
        
        -- ตรวจสอบค่า Rebirths ปัจจุบันของผู้เล่น
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        local currentRebirths = (leaderstats and leaderstats:FindFirstChild("Rebirths")) and leaderstats.Rebirths.Value or 0
        
        if useRebirthTarget and currentRebirths >= targetRebirths then
            stopRebirth()
            EclipseLib:Notify({
                Title = "🎯 Rebirth ครบตามเป้าหมายแล้ว!",
                Content = "คุณมี Rebirths ครบ " .. tostring(currentRebirths) .. " / " .. tostring(targetRebirths) .. " ครั้งแล้ว ปิดระบบรีเบิร์ดทันที! 🛑",
                Duration = 5,
                Type = "success"
            })
            return
        end

        pcall(function()
            rebirthRemote:InvokeServer("rebirthRequest")
        end)
        task.wait(0.5)
    end)
end

-- ════════ STATS VIEWER ════════
local function getPlayerStats(player)
    local stats = {}
    
    stats.Agility = player:FindFirstChild("Agility") and player.Agility.Value or 0
    stats.Durability = player:FindFirstChild("Durability") and player.Durability.Value or 0
    
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        stats.Kills = leaderstats:FindFirstChild("Kills") and leaderstats.Kills.Value or 0
        stats.Strength = leaderstats:FindFirstChild("Strength") and leaderstats.Strength.Value or 0
        stats.Rebirths = leaderstats:FindFirstChild("Rebirths") and leaderstats.Rebirths.Value or 0
        stats.Brawls = leaderstats:FindFirstChild("Brawls") and leaderstats.Brawls.Value or 0
    else
        stats.Kills = 0
        stats.Strength = 0
        stats.Rebirths = 0
        stats.Brawls = 0
    end
    
    stats.GoodKarma = player:FindFirstChild("goodKarma") and player.goodKarma.Value or 0
    stats.BadKarma = player:FindFirstChild("badKarma") and player.badKarma.Value or 0
    stats.MaxPetCapacity = player:FindFirstChild("maxPetCapacity") and player.maxPetCapacity.Value or 0
    stats.Gems = player:FindFirstChild("Gems") and player.Gems.Value or 0
    
    -- ตรวจสอบบูสโปรตีน
    local consumablesFolder = player:FindFirstChild("consumablesFolder")
    local boosts = {}
    if consumablesFolder then
        for _, item in ipairs(consumablesFolder:GetChildren()) do
            table.insert(boosts, item.Name .. " x" .. (item:IsA("NumberValue") and item.Value or 1))
        end
    end
    
    return stats, boosts
end

