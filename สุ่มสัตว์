-- ฟังก์ชั่นแปลงตัวเลขเป็น k, m, b, t (เช่น 100,000 -> 100k / 1,000,000 -> 1m)
local function formatNumber(val)
    local n = tonumber(val) or 0
    local sign = n < 0 and "-" or ""
    n = math.abs(n)
    if n >= 1e12 then
        local formatted = string.format("%.2f", n / 1e12):gsub("%.?0+$", "")
        return sign .. formatted .. "t"
    elseif n >= 1e9 then
        local formatted = string.format("%.2f", n / 1e9):gsub("%.?0+$", "")
        return sign .. formatted .. "b"
    elseif n >= 1e6 then
        local formatted = string.format("%.2f", n / 1e6):gsub("%.?0+$", "")
        return sign .. formatted .. "m"
    elseif n >= 1e3 then
        local formatted = string.format("%.2f", n / 1e3):gsub("%.?0+$", "")
        return sign .. formatted .. "k"
    end
    return sign .. tostring(n)
end

