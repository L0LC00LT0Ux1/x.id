    local function findNil(name)
        if typeof(getnilinstances) ~= "function" then return nil end
        local success, instances = pcall(getnilinstances)
        if not success or not instances then return nil end
        for _, o in ipairs(instances) do if o and o.Name == name then return o end end
        return nil
    end

    local function findNilDbg(name, id)
        if typeof(getnilinstances) ~= "function" then return nil end
        local success, instances = pcall(getnilinstances)
        if not success or not instances then return nil end
        for _, o in ipairs(instances) do 
            if o and o.Name == name then
                local dbgId = nil
                if typeof(getdebugid) == "function" then
                    pcall(function() dbgId = getdebugid(o) end)
                elseif pcall(function() return o.GetDebugId end) and typeof(o.GetDebugId) == "function" then
                    pcall(function() dbgId = o:GetDebugId() end)
                end
                if dbgId == id then return o end
            end
        end
        return nil
    end

    local function sellPet(name)
        for _, f in ipairs(PET_FOLDERS) do if f then local p = f:FindFirstChild(name) if p then sellPetEvent:FireServer("sellPet", p) return true end end end
        local n = findNil(name) if n then sellPetEvent:FireServer("sellPet", n) return true end return false
    end

    local function sellAura(name)
        for _, f in ipairs(AURA_FOLDERS) do if f then local a = f:FindFirstChild(name) if a then sellPowerUpEvent:FireServer("sellPowerUp", a) return true end end end
        local n = findNil(name) if n then sellPowerUpEvent:FireServer("sellPowerUp", n) return true end return false
    end

    local function sellPetDbg(name, id)
        for _, f in ipairs(PET_FOLDERS) do if f then local p = f:FindFirstChild(name) if p then sellPetEvent:FireServer("sellPet", p) return true end end end
        local n = findNilDbg(name, id) if n then sellPetEvent:FireServer("sellPet", n) return true end return false
    end

    local function sellAuraDbg(name, id)
        for _, f in ipairs(AURA_FOLDERS) do if f then local a = f:FindFirstChild(name) if a then sellPowerUpEvent:FireServer("sellPowerUp", a) return true end end end
        local n = findNilDbg(name, id) if n then sellPowerUpEvent:FireServer("sellPowerUp", n) return true end return false
    end

