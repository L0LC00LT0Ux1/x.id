    local function countPet(name)
        local count = 0
        for _, folder in ipairs(PET_FOLDERS) do
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if child.Name == name then count = count + 1 end
                end
            end
        end
        return count
    end

    local function tryEvolve(cfg)
        if evolving or not cfg.Enabled then return end
        local count = countPet(cfg.Target)
        if count >= cfg.Need then
            evolving = true
            pcall(function() petEvolveEvent:FireServer("evolvePet", cfg.Target) end)
            evolving = false
        end
    end

