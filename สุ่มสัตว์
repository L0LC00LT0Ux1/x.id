    local function findNil(name)
        if typeof(getnilinstances) ~= "function" then return nil end
        for _, o in ipairs(getnilinstances()) do if o.Name == name then return o end end
    end

    local function findNilDbg(name, id)
        if typeof(getnilinstances) ~= "function" then return nil end
        for _, o in ipairs(getnilinstances()) do if o.Name == name and o:GetDebugId() == id then return o end end
    end

