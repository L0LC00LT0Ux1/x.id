-- ════════ FARMING & REBIRTH LOGIC ════════
local function getMuscleEvent() return LocalPlayer:FindFirstChild("muscleEvent") end

local function equipTool(toolName)
    local char = LocalPlayer.Character if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid") if not humanoid then return false end
    local tool = LocalPlayer.Backpack:FindFirstChild(toolName) or char:FindFirstChild(toolName)
    if tool then humanoid:EquipTool(tool) return true end
    return false
end

local function fireMuscle()
    local event = getMuscleEvent()
    if event then pcall(function() event:FireServer("rep") end) end
end

local function startFarming()
    if not farmTool then return end
    farmEnabled = true
    farmConn = RunService.Heartbeat:Connect(function()
        if not farmEnabled then return end
        if not equipTool(farmTool) then
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                local tool = LocalPlayer.Backpack:FindFirstChild(farmTool) or char:FindFirstChild(farmTool)
                if tool then char.Humanoid:EquipTool(tool) end
            end
        end
        fireMuscle()
        task.wait(fastMode and 0.01 or 0.1)
    end)
end

local function stopFarming()
    farmEnabled = false
    if farmConn then farmConn:Disconnect() farmConn = nil end
end

local function stopRebirth()
    rebirthEnabled = false
    if rebirthConn then rebirthConn:Disconnect() rebirthConn = nil end
end

local function startRebirth()
    rebirthEnabled = true
    rebirthConn = RunService.Heartbeat:Connect(function()
        if not rebirthEnabled then return end
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        local currentRebirths = (leaderstats and leaderstats:FindFirstChild("Rebirths")) and leaderstats.Rebirths.Value or 0
        
        if useRebirthTarget and currentRebirths >= targetRebirths then
            stopRebirth()
            return
        end
        pcall(function() rebirthRemote:InvokeServer("rebirthRequest") end)
        task.wait(0.5)
    end)
end

