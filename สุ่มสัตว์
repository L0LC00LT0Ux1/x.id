local function getPlayerStats(player)
    local stats = {}
    stats.Agility = player:FindFirstChild("Agility") and player.Agility.Value or 0
    stats.Durability = player:FindFirstChild("Durability") and player.Durability.Value or 0
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        stats.Kills = leaderstats:FindFirstChild("Kills") and leaderstats.Kills.Value or 0
        stats.Strength = leaderstats:FindFirstChild("Strength") and leaderstats.Strength.Value or 0
        stats.Rebirths = leaderstats:FindFirstChild("Rebirths") and leaderstats.Rebirths.Value or 0
        stats.Brawls = leaderstats:FindFirstChild("Brawls") and leaderstats.Brawls.Value or 0
    else stats.Kills, stats.Strength, stats.Rebirths, stats.Brawls = 0,0,0,0 end
    stats.GoodKarma = player:FindFirstChild("goodKarma") and player.goodKarma.Value or 0
    stats.BadKarma = player:FindFirstChild("badKarma") and player.badKarma.Value or 0
    stats.MaxPetCapacity = player:FindFirstChild("maxPetCapacity") and player.maxPetCapacity.Value or 0
    stats.Gems = player:FindFirstChild("Gems") and player.Gems.Value or 0
    local consumablesFolder = player:FindFirstChild("consumablesFolder")
    local boosts = {}
    if consumablesFolder then
        for _, item in ipairs(consumablesFolder:GetChildren()) do
            table.insert(boosts, item.Name .. " x" .. (item:IsA("NumberValue") and item.Value or 1))
        end
    end
    return stats, boosts
end

local function renderStatsOnGUI(player)
    if not player then return end
    local stats, boosts = getPlayerStats(player)
    StatsDisplay.Text = string.format(
        " 👤 ชื่อผู้เล่น: %s\n" ..
        " ⚡ Agility: %s | 🛡️ Durability: %s\n" ..
        " ⚔️ Kills: %s | 💪 Strength: %s\n" ..
        " 🔄 Rebirths: %s | 🥊 Brawls: %s\n" ..
        " 😇 กรรมดี: %s | 😈 กรรมชั่ว: %s\n" ..
        " 🐾 ความจุสัตว์: %s | 💎 Gems: %s\n" ..
        " 🧪 บูส: %s",
        player.Name, formatNumber(stats.Agility), formatNumber(stats.Durability), formatNumber(stats.Kills),
        formatNumber(stats.Strength), formatNumber(stats.Rebirths), formatNumber(stats.Brawls),
        formatNumber(stats.GoodKarma), formatNumber(stats.BadKarma), formatNumber(stats.MaxPetCapacity),
        formatNumber(stats.Gems), (#boosts > 0 and table.concat(boosts, ", ") or "ไม่มี")
    )
end

