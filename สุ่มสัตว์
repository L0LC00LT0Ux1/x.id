        tostring(stats.Durability),
        tostring(stats.Kills),
        tostring(stats.Strength),
        tostring(stats.Rebirths),
        tostring(stats.Brawls),
        tostring(stats.GoodKarma),
        tostring(stats.BadKarma),
        tostring(stats.MaxPetCapacity),
        tostring(stats.Gems),
        (#boosts > 0 and table.concat(boosts, ", ") or "ไม่มี")
    )
    
    if StatsParagraph and StatsParagraph.Set then
        StatsParagraph:Set({
            Title = "📊 ข้อมูลของ " .. player.Name,
            Content = contentText
        })
    elseif StatsParagraph and StatsParagraph.Update then
        StatsParagraph:Update({
            Title = "📊 ข้อมูลของ " .. player.Name,
            Content = contentText
        })
    end
end

